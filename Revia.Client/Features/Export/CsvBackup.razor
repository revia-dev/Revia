@using Revia.Client.Features.Export
@using Revia.Shared.Export
@inject CsvBackupClientService Csv

@*
    CSV export + import for a module. Drop in with <CsvBackup Module="bmi" Label="BMI" />.
    Export downloads the module's CSV; import uploads a CSV (adds rows, matching people
    by name) and shows how many were imported/skipped. Online only.
*@
<div class="csv-backup">
    @if (Csv.IsOnline)
    {
        <details>
            <summary>CSV-Backup</summary>
            <div class="csv-actions">
                <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="ExportAsync">CSV exportieren</button>
                @if (AllowImport)
                {
                    <label class="btn btn-outline-secondary btn-sm csv-import-btn">
                        CSV importieren
                        <InputFile OnChange="ImportAsync" accept=".csv,text/csv" hidden disabled="@_busy" />
                    </label>
                }
                @if (_busy) { <span class="wl-muted">…</span> }
            </div>
            @if (_message is not null)
            {
                <p class="@(_ok ? "wl-syncing" : "login-error") csv-result">@_message</p>
            }
        </details>
    }
</div>

@code {
    /// <summary>API route segment + export file name (e.g. "bmi", "movies", "matches").</summary>
    [Parameter, EditorRequired] public string Module { get; set; } = "";
    /// <summary>Human label used for the download file name.</summary>
    [Parameter] public string Label { get; set; } = "export";
    /// <summary>Whether to show the import action (export is always available).</summary>
    [Parameter] public bool AllowImport { get; set; } = true;
    /// <summary>Raised after a successful import so the page can reload its data.</summary>
    [Parameter] public EventCallback OnImported { get; set; }

    private bool _busy;
    private bool _ok;
    private string? _message;

    private async Task ExportAsync()
    {
        _busy = true; _message = null;
        var ok = await Csv.ExportAsync(Module, $"{Label}.csv");
        _busy = false;
        if (!ok) { _ok = false; _message = "Export fehlgeschlagen."; }
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        _busy = true; _message = null;
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 16 * 1024 * 1024);
            // Buffer to a MemoryStream so the upload has a known length.
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var result = await Csv.ImportAsync(Module, ms, e.File.Name);
            if (result is null)
            {
                _ok = false; _message = "Import fehlgeschlagen (offline oder kein Zugriff?).";
            }
            else
            {
                _ok = result.Imported > 0;
                _message = $"{result.Imported} importiert, {result.Skipped} übersprungen."
                    + (result.Errors.Count > 0 ? " " + string.Join(" ", result.Errors.Take(3)) : "");
                if (result.Imported > 0) { await OnImported.InvokeAsync(); }
            }
        }
        catch
        {
            _ok = false; _message = "Datei konnte nicht gelesen werden.";
        }
        finally { _busy = false; }
    }
}
