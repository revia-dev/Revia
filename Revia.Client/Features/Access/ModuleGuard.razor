@using Revia.Client.Features.Access
@inject AccessClientService Access
@inject NavigationManager Navigation

@if (_checked && _allowed)
{
    <CascadingValue Value="_canWrite" Name="CanWrite">
        @ChildContent
    </CascadingValue>
}

@code {
    /// <summary>Module key (e.g. "movies"). Read access is required to render the
    /// content; without it the user is redirected to the dashboard. Write access is
    /// cascaded as a bool named "CanWrite" so pages can hide write actions.</summary>
    [Parameter, EditorRequired] public string ModuleKey { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _checked;
    private bool _allowed;
    private bool _canWrite;

    protected override async Task OnInitializedAsync()
    {
        await Access.GetMyAccessAsync();
        _allowed = Access.CanRead(ModuleKey);
        _canWrite = Access.CanWrite(ModuleKey);
        _checked = true;

        if (!_allowed)
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }
}
