@using Revia.Client.Offline
@inject ConnectivityService Connectivity

@if (Connectivity.IsOnline)
{
    <div class="photo-uploader">
        <label class="wl-muted">@Label</label>
        <InputFile OnChange="OnSelected" accept="@Accept" multiple="@Multiple" />
        @if (_busy) { <span class="wl-muted">Lädt…</span> }
        @if (_error is not null) { <span class="login-error">@_error</span> }
    </div>
}
else
{
    <span class="wl-muted" title="Dateien können nur online hochgeladen werden">⬆ offline</span>
}

@code {
    /// <summary>One chosen file, ready to send (base64).</summary>
    public sealed record UploadedFile(string Base64, string ContentType, string FileName);

    /// <summary>Called once per chosen file. Return true if the upload succeeded
    /// (so the uploader can report a per-file failure).</summary>
    [Parameter, EditorRequired] public Func<UploadedFile, Task<bool>>? OnUpload { get; set; }
    [Parameter] public EventCallback OnUploaded { get; set; }
    [Parameter] public string Label { get; set; } = "Datei hinzufügen";
    /// <summary>HTML accept filter (e.g. "image/*" or ".pdf,application/pdf").</summary>
    [Parameter] public string Accept { get; set; } = "image/*";
    [Parameter] public bool Multiple { get; set; } = true;
    [Parameter] public long MaxBytes { get; set; } = 16 * 1024 * 1024;

    private bool _busy;
    private string? _error;

    private async Task OnSelected(InputFileChangeEventArgs e)
    {
        if (OnUpload is null) return;
        _busy = true; _error = null;
        var anyFailed = false;

        foreach (var file in e.GetMultipleFiles(maximumFileCount: 10))
        {
            if (file.Size > MaxBytes) { _error = $"„{file.Name}" + "“ ist zu groß."; anyFailed = true; continue; }
            try
            {
                using var ms = new MemoryStream();
                await file.OpenReadStream(MaxBytes).CopyToAsync(ms);
                var uploaded = new UploadedFile(
                    Convert.ToBase64String(ms.ToArray()),
                    string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                    file.Name);
                if (!await OnUpload(uploaded)) { anyFailed = true; }
            }
            catch { anyFailed = true; }
        }

        _busy = false;
        if (anyFailed && _error is null) { _error = "Mindestens eine Datei konnte nicht hochgeladen werden."; }
        await OnUploaded.InvokeAsync();
    }
}
