@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<Revia.Client.Resources.AppStrings> Loc

<PageTitle>Anmelden – Revia</PageTitle>

<div class="login-shell">
    <div class="login-card">
        <div class="login-brand">
            <img src="icon-192.png" alt="Revia" class="login-logo" />
            <div>
                <div class="login-eyebrow">Revia</div>
                <div class="login-title">@Loc["Login_Title"]</div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="login-error">@_error</div>
        }

        <EditForm Model="this" OnValidSubmit="SubmitAsync">
            <div class="login-field">
                <label for="user">@Loc["Login_Username"]</label>
                <input id="user" class="form-control" @bind="_userName" @bind:event="oninput" autocomplete="username" />
            </div>
            <div class="login-field">
                <label for="pw">@Loc["Login_Password"]</label>
                <input id="pw" type="password" class="form-control" @bind="_password" @bind:event="oninput" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary login-submit" disabled="@_busy">
                @(_busy ? Loc["Login_Submit"].Value + "…" : Loc["Login_Submit"].Value)
            </button>
        </EditForm>

        <button class="btn btn-outline-secondary login-demo" disabled="@_busy" @onclick="DemoAsync">
            Demo starten
        </button>
        <p class="login-demo-note">Isolierte Beispieldaten – bei jedem Start frisch zurückgesetzt.</p>
    </div>
</div>

@code {
    private string _userName = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        var (ok, error) = await Auth.LoginAsync(_userName, _password);
        _busy = false;

        if (!ok)
        {
            _error = error;
            return;
        }

        // Full reload so the app re-boots cleanly for the new user: the eager access
        // resolve runs and no previous user's cached state (access, layout) lingers.
        Navigation.NavigateTo(ResolveReturnUrl(), forceLoad: true);
    }

    private async Task DemoAsync()
    {
        _busy = true;
        _error = null;
        var ok = await Auth.LoginDemoAsync();
        _busy = false;
        if (!ok) { _error = "Demo-Modus ist nicht verfügbar."; return; }
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private string ResolveReturnUrl()
    {
        var query = new Uri(Navigation.Uri).Query;          // e.g. "?returnUrl=lending"
        const string marker = "returnUrl=";
        var idx = query.IndexOf(marker, StringComparison.Ordinal);
        if (idx < 0)
        {
            return "/";
        }
        var value = query[(idx + marker.Length)..];
        var amp = value.IndexOf('&');
        if (amp >= 0)
        {
            value = value[..amp];
        }
        value = Uri.UnescapeDataString(value);
        return string.IsNullOrWhiteSpace(value) ? "/" : "/" + value.TrimStart('/');
    }
}
