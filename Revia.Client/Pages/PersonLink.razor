@page "/persons/link/{Token}"
@attribute [Authorize]
@using Revia.Client.Features.Persons
@using Revia.Client.Offline
@using Revia.Shared.Persons
@inject PersonsClientService PersonsSvc
@inject ConnectivityService Connectivity
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<Revia.Client.Resources.AppStrings> Loc

<PageTitle>Person übernehmen – Revia</PageTitle>

<ModuleGuard ModuleKey="persons">

<div class="wl-head">
    <h1>Person übernehmen</h1>
    <a class="btn btn-outline-secondary btn-sm" href="/persons">@Loc["App_Back"]</a>
</div>

<div class="glass game-editor">
    @if (!Connectivity.IsOnline)
    {
        <p class="wl-muted">Zum Übernehmen musst du online sein.</p>
    }
    else if (_loading)
    {
        <p class="wl-muted">Lade…</p>
    }
    else if (_preview is null || !_preview.Found)
    {
        <div class="login-error">Zu diesem Link wurde keine Person gefunden.</div>
    }
    else if (_preview.SameHousehold)
    {
        <p>Diese Person (<strong>@_preview.DisplayName</strong>) gehört bereits zu deinem Haushalt.</p>
    }
    else if (_done)
    {
        <p class="wl-syncing">@_preview.DisplayName wurde übernommen und die Haushalte sind verknüpft.</p>
        <a class="btn btn-primary" href="/persons">Zu den Personen</a>
    }
    else
    {
        <p>
            Folgende Person aus dem Haushalt <strong>@(_preview.HouseholdName ?? "?")</strong>
            kann in deinen Haushalt übernommen werden. Dabei werden beide Haushalte verknüpft –
            anschließend siehst du auch deren Ausleihen.
        </p>
        <ul class="link-facts">
            <li><span class="wl-muted">Name</span> <strong>@_preview.DisplayName</strong></li>
            @if (!string.IsNullOrWhiteSpace(_preview.Email)) { <li><span class="wl-muted">E-Mail</span> @_preview.Email</li> }
            @if (!string.IsNullOrWhiteSpace(_preview.Phone)) { <li><span class="wl-muted">Telefon</span> @_preview.Phone</li> }
            @if (!string.IsNullOrWhiteSpace(_preview.Location)) { <li><span class="wl-muted">Ort</span> @_preview.Location</li> }
        </ul>
        <div class="game-actions">
            <button class="btn btn-primary" disabled="@_working" @onclick="ImportAsync">Übernehmen &amp; verknüpfen</button>
            <a class="btn btn-outline-secondary" href="/persons">Abbrechen</a>
        </div>
        @if (_error is not null) { <div class="login-error">@_error</div> }
    }
</div>

</ModuleGuard>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private PersonLinkPreviewDto? _preview;
    private bool _loading = true;
    private bool _working;
    private bool _done;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (Connectivity.IsOnline)
        {
            _preview = await PersonsSvc.PreviewLinkAsync(Token);
        }
        _loading = false;
    }

    private async Task ImportAsync()
    {
        _working = true; _error = null;
        var result = await PersonsSvc.ImportLinkAsync(Token);
        _working = false;
        if (result.Success) { _done = true; }
        else { _error = result.Error ?? "Übernehmen fehlgeschlagen."; }
    }
}
