@page "/admin/permissions"
@attribute [Authorize]
@using PrivateLibrary.Client.Features.Access
@using PrivateLibrary.Shared.Access
@inject AccessClientService Access
@inject AdminPermissionsClientService Admin
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<PrivateLibrary.Client.Resources.AppStrings> Loc

<PageTitle>Berechtigungen – Revia</PageTitle>

<div class="wl-head">
    <h1>@Loc["Page_Permissions"]</h1>
    <a class="btn btn-outline-secondary btn-sm" href="/">@Loc["App_Back"]</a>
</div>

@if (!_ready)
{
    <p class="wl-muted">Lade…</p>
}
else if (!Access.IsAdmin)
{
    <p class="wl-muted">Kein Zugriff.</p>
}
else if (!Admin.IsOnline)
{
    <p class="wl-muted">Berechtigungen können nur online verwaltet werden.</p>
}
else
{
    <p class="wl-muted">Lege je Benutzer und Modul fest, wer lesen und schreiben darf. Administratoren haben immer vollen Zugriff. Änderungen werden sofort gespeichert.</p>

    <div class="perm-pick glass">
        <label>Benutzer</label>
        <select class="form-control" @bind="_selectedUserId" @bind:after="LoadGrantsAsync">
            <option value="">Bitte wählen</option>
            @foreach (var u in _users)
            {
                <option value="@u.Id">@(string.IsNullOrWhiteSpace(u.DisplayName) ? u.Id : u.DisplayName)</option>
            }
        </select>
    </div>

    @if (!string.IsNullOrEmpty(_selectedUserId) && _grants is not null)
    {
        <table class="perm-table glass">
            <thead>
                <tr><th>Modul</th><th class="perm-col">Lesen</th><th class="perm-col">Schreiben</th></tr>
            </thead>
            <tbody>
                @foreach (var m in _grants)
                {
                    var module = m;
                    <tr>
                        <td>@ModuleLabel(module.Module)</td>
                        <td class="perm-col">
                            <input type="checkbox" checked="@module.CanRead"
                                   @onchange="e => SetReadAsync(module, (bool)e.Value!)" />
                        </td>
                        <td class="perm-col">
                            <input type="checkbox" checked="@module.CanWrite"
                                   @onchange="e => SetWriteAsync(module, (bool)e.Value!)" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="wl-muted">Schreibrecht schließt Leserecht automatisch ein.</p>
        @if (_savedNote is not null) { <p class="wl-syncing">@_savedNote</p> }
    }
}

@code {
    private bool _ready;
    private List<AdminUserDto> _users = new();
    private List<ModuleInfoDto> _modules = new();
    private string _selectedUserId = string.Empty;
    private List<ModuleAccessDto>? _grants;
    private string? _savedNote;

    protected override async Task OnInitializedAsync()
    {
        await Access.GetMyAccessAsync();
        if (!Access.IsAdmin)
        {
            _ready = true;
            Navigation.NavigateTo("/", replace: true);
            return;
        }
        _modules = await Access.GetModulesAsync();
        _users = await Admin.GetUsersAsync();
        _ready = true;
    }

    private string ModuleLabel(string key) => _modules.FirstOrDefault(m => m.Key == key)?.Label ?? key;

    private async Task LoadGrantsAsync()
    {
        _savedNote = null;
        if (string.IsNullOrEmpty(_selectedUserId)) { _grants = null; return; }
        var g = await Admin.GetGrantsAsync(_selectedUserId);
        _grants = g?.Modules;
    }

    // Unchecking read also removes write (write implies read); checking write also
    // grants read. This keeps the two boxes consistent with the server's rule.
    private Task SetReadAsync(ModuleAccessDto module, bool canRead)
        => SaveAsync(module, canRead, canRead && module.CanWrite);

    private Task SetWriteAsync(ModuleAccessDto module, bool canWrite)
        => SaveAsync(module, module.CanRead || canWrite, canWrite);

    private async Task SaveAsync(ModuleAccessDto module, bool canRead, bool canWrite)
    {
        if (string.IsNullOrEmpty(_selectedUserId)) return;
        if (await Admin.SetGrantAsync(_selectedUserId, module.Module, canRead, canWrite))
        {
            module.CanRead = canRead;
            module.CanWrite = canWrite;
            _savedNote = $"„{ModuleLabel(module.Module)}" + "“ aktualisiert.";
        }
    }
}
