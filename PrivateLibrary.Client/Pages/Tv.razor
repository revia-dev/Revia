@page "/tv"
@attribute [Authorize]
@using PrivateLibrary.Client.Features.Tv
@using PrivateLibrary.Client.Offline
@using PrivateLibrary.Shared.Tv
@inject TvClientService TvSvc
@inject ConnectivityService Connectivity
@inject SyncEngine Sync
@inject Microsoft.Extensions.Localization.IStringLocalizer<PrivateLibrary.Client.Resources.AppStrings> Loc
@implements IDisposable

<PageTitle>TV – Revia</PageTitle>

<ModuleGuard ModuleKey="tv">

<PageHeader Title="@Loc["Page_Tv"]" Pending="_pending" />

<div class="tv-tabs">
    <button class="tv-tab @(_tab == Tab.Private ? "is-active" : "")" @onclick="() => SwitchTab(Tab.Private)">Mein Programm</button>
    <button class="tv-tab @(_tab == Tab.Family ? "is-active" : "")" @onclick="() => SwitchTab(Tab.Family)">Familie</button>
</div>

@if (_tab == Tab.Private)
{
    <div class="glass tv-add">
        <select class="form-control" @bind="_movieId">
            <option value="">Film wählen…</option>
            @foreach (var m in _options.Take(300))
            {
                <option value="@m.Id">@m.Title @(string.IsNullOrWhiteSpace(m.Year) ? "" : $"({m.Year})")</option>
            }
        </select>
        <input class="form-control" type="datetime-local" @bind="_startsAt" @bind:event="oninput" />
        <input class="form-control" placeholder="Sender" @bind="_channel" @bind:event="oninput" />
        <label class="tv-share"><input type="checkbox" @bind="_shared" /> Freigeben</label>
        <button class="btn btn-primary" @onclick="AddAsync" disabled="@(string.IsNullOrEmpty(_movieId))">Hinzufügen</button>
    </div>
}

@if (_loading)
{
    <p class="wl-muted">Lade…</p>
}
else if (_entries.Count == 0)
{
    <p class="wl-muted">Keine Einträge.</p>
}
else
{
    @foreach (var day in _entries.GroupBy(e => e.StartsAt.Date).OrderBy(g => g.Key))
    {
        <div class="tv-day">
            <div class="tv-day-head">@day.Key.ToString("dddd, dd.MM.yyyy")</div>
            @foreach (var e in day.OrderBy(x => x.StartsAt))
            {
                var prog = Progress(e);
                <div class="tv-entry @(prog.Status == AirStatus.Live ? "is-live" : "")" @key="e.Id">
                    <div class="tv-time">
                        @e.StartsAt.ToString("HH:mm")
                        @if (EndOf(e) is DateTime end) { <span class="tv-end">–@end.ToString("HH:mm")</span> }
                    </div>
                    <div class="tv-body">
                        <div class="tv-title">
                            @e.MovieTitle
                            @if (e.IsSeries && e.Episode is int ep) { <span class="badge tv-episode">Folge @ep</span> }
                        </div>
                        <div class="tv-meta">
                            @if (!string.IsNullOrWhiteSpace(e.Channel)) { <span>@e.Channel</span> }
                            @if (_tab == Tab.Family && e.HasPrivateOwner && !string.IsNullOrEmpty(e.OwnerDisplayName))
                            {
                                <span class="badge">von @e.OwnerDisplayName</span>
                            }
                            @if (_tab == Tab.Private && e.SharedWithHousehold) { <span class="badge badge-ok">freigegeben</span> }
                            <span class="tv-status @StatusClass(prog.Status)">@prog.Label</span>
                        </div>
                        @if (prog.Status != AirStatus.Unknown)
                        {
                            <div class="tv-progress" title="@prog.Label">
                                <span class="tv-progress-fill" style="width:@prog.Percent%"></span>
                            </div>
                        }
                    </div>
                    @if (_tab == Tab.Private)
                    {
                        <div class="tv-actions">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => ToggleShareAsync(e)">
                                @(e.SharedWithHousehold ? "Freigabe zurück" : "Freigeben")
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(e.Id)">Löschen</button>
                        </div>
                    }
                </div>
            }
        </div>
    }
}

</ModuleGuard>

@code {
    private enum Tab { Private, Family }
    private Tab _tab = Tab.Private;

    private List<TvEntryDto> _entries = new();
    private List<TvMovieOptionDto> _options = new();
    private string _movieId = string.Empty;
    private DateTime _startsAt = DateTime.Now.Date.AddHours(20).AddMinutes(15);
    private string? _channel;
    private bool _shared;
    private bool _loading = true;
    private int _pending;

    // Ticks the live progress bars without re-fetching data.
    private System.Threading.Timer? _tick;

    protected override async Task OnInitializedAsync()
    {
        Connectivity.Changed += OnConnectivityChanged;
        Sync.Synced += OnSynced;
        _options = await TvSvc.GetMovieOptionsAsync();
        await ReloadAsync();
        _pending = await Sync.PendingCountAsync();
        _loading = false;

        // Re-render every 30s so "läuft seit / noch …" and the progress bar stay live.
        _tick = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null,
            TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    // ---- live air status + progress ----

    private enum AirStatus { Unknown, Upcoming, Live, Ended }

    private readonly record struct AirProgress(AirStatus Status, int Percent, string Label);

    private static DateTime? EndOf(TvEntryDto e)
        => e.RuntimeMinutes is int r and > 0 ? e.StartsAt.AddMinutes(r) : null;

    private static AirProgress Progress(TvEntryDto e)
    {
        var now = DateTime.Now;
        var end = EndOf(e);
        if (end is null)
        {
            // No runtime → can't draw a bar; just say upcoming/over by start time.
            return now < e.StartsAt
                ? new AirProgress(AirStatus.Unknown, 0, UntilLabel(e.StartsAt - now))
                : new AirProgress(AirStatus.Unknown, 0, "");
        }

        if (now < e.StartsAt)
        {
            return new AirProgress(AirStatus.Upcoming, 0, "in " + UntilLabel(e.StartsAt - now));
        }
        if (now >= end.Value)
        {
            return new AirProgress(AirStatus.Ended, 100, "vorbei");
        }

        var total = (end.Value - e.StartsAt).TotalMinutes;
        var elapsed = (now - e.StartsAt).TotalMinutes;
        var pct = total > 0 ? (int)Math.Clamp(Math.Round(elapsed / total * 100), 0, 100) : 0;
        var remaining = (int)Math.Ceiling((end.Value - now).TotalMinutes);
        return new AirProgress(AirStatus.Live, pct, $"läuft · noch {remaining} min");
    }

    private static string UntilLabel(TimeSpan span)
    {
        if (span.TotalMinutes < 60) { return $"{Math.Max(1, (int)Math.Ceiling(span.TotalMinutes))} min"; }
        if (span.TotalHours < 24) { return $"{(int)span.TotalHours} h {span.Minutes} min"; }
        return $"{(int)span.TotalDays} Tg";
    }

    private static string StatusClass(AirStatus s) => s switch
    {
        AirStatus.Live => "tv-st-live",
        AirStatus.Upcoming => "tv-st-upcoming",
        AirStatus.Ended => "tv-st-ended",
        _ => ""
    };

    private async Task SwitchTab(Tab tab)
    {
        _tab = tab;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _entries = _tab == Tab.Private ? await TvSvc.GetPrivateAsync() : await TvSvc.GetFamilyAsync();
        StateHasChanged();
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrEmpty(_movieId) || !Guid.TryParse(_movieId, out var mid)) { return; }
        var title = _options.FirstOrDefault(o => o.Id == mid)?.Title ?? "Film";
        await TvSvc.AddPrivateAsync(mid, title, _startsAt, _channel, null, _shared);
        _movieId = string.Empty; _channel = null; _shared = false;
        await AfterWriteAsync();
    }

    private async Task ToggleShareAsync(TvEntryDto e)
    {
        await TvSvc.SetSharedAsync(e.Id, !e.SharedWithHousehold);
        await AfterWriteAsync();
    }

    private async Task DeleteAsync(int id)
    {
        await TvSvc.DeleteAsync(id);
        await AfterWriteAsync();
    }

    private async Task AfterWriteAsync()
    {
        await ReloadAsync();
        _pending = await Sync.PendingCountAsync();
        StateHasChanged();
    }

    private async void OnConnectivityChanged(bool online) => await InvokeAsync(ReloadAsync);
    private async void OnSynced(SyncResult result)
        => await InvokeAsync(async () => { await ReloadAsync(); _pending = result.Remaining; StateHasChanged(); });

    public void Dispose()
    {
        Connectivity.Changed -= OnConnectivityChanged;
        Sync.Synced -= OnSynced;
        _tick?.Dispose();
    }
}
