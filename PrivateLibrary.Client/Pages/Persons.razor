@page "/persons"
@attribute [Authorize]
@using PrivateLibrary.Client.Features.Persons
@using PrivateLibrary.Client.Features.Access
@using PrivateLibrary.Client.Offline
@using PrivateLibrary.Shared.Persons
@inject PersonsClientService PersonsSvc
@inject AccessClientService Access
@inject ConnectivityService Connectivity
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<PrivateLibrary.Client.Resources.AppStrings> Loc

<PageTitle>Personen – Revia</PageTitle>

<ModuleGuard ModuleKey="persons">

<div class="wl-head">
    <h1>@Loc["Page_Persons"]</h1>
    @if (!Connectivity.IsOnline) { <span class="wl-offline">⚡ Offline</span> }
    <button class="btn btn-primary btn-sm" @onclick="StartCreate">Person hinzufügen</button>
</div>

<CsvBackup Module="persons" Label="Personen" OnImported="ReloadAsync" />

@if (_edit is not null)
{
    <div class="glass game-editor">
        <h2 class="ui-section-title">@(string.IsNullOrEmpty(_edit.Id) ? "Neue Person (ohne Login)" : "Person bearbeiten")</h2>
        <div class="game-form">
            <div class="game-field"><label>Vorname</label>
                <input class="form-control" @bind="_edit.FirstName" @bind:event="oninput" /></div>
            <div class="game-field"><label>Nachname</label>
                <input class="form-control" @bind="_edit.LastName" @bind:event="oninput" /></div>
            <div class="game-field"><label>Spitzname</label>
                <input class="form-control" @bind="_edit.Nickname" /></div>
            <div class="game-field"><label>E-Mail</label>
                <input class="form-control" @bind="_edit.Email" /></div>
            <div class="game-field"><label>Telefon</label>
                <input class="form-control" @bind="_edit.Phone" /></div>
            <div class="game-field"><label>Ort</label>
                <input class="form-control" @bind="_edit.City" /></div>
        </div>
        <div class="game-actions">
            <button class="btn btn-primary" @onclick="SaveAsync"
                    disabled="@(string.IsNullOrWhiteSpace(_edit.FirstName) && string.IsNullOrWhiteSpace(_edit.LastName))">@Loc["App_Save"]</button>
            <button class="btn btn-outline-secondary" @onclick="() => _edit = null">@Loc["App_Cancel"]</button>
        </div>
        @if (_error is not null) { <div class="login-error">@_error</div> }
    </div>
}

@if (_loading)
{
    <p class="wl-muted">Lade…</p>
}
else
{
    @if (_linked.Count > 0)
    {
        <div class="glass linked-households">
            <span class="wl-muted">Verknüpfte Haushalte (geteilte Ausleihen):</span>
            @foreach (var h in _linked) { <span class="badge">@h.Name</span> }
        </div>
    }

    @if (_people.Count == 0)
    {
        <p class="wl-muted">Keine Personen.</p>
    }
    else
    {
        <div class="person-grid">
            @foreach (var p in _people)
            {
                <div class="person-card glass" @key="p.Id">
                    <div class="person-name">
                        @p.DisplayName
                        @if (p.IsLoginless) { <span class="badge">ohne Login</span> } else { <span class="badge badge-ok">Login</span> }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(p.Email)) { <div class="wl-muted">@p.Email</div> }
                    @if (!string.IsNullOrWhiteSpace(p.Phone)) { <div class="wl-muted">@p.Phone</div> }
                    <div class="person-actions">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => StartEdit(p)">@Loc["App_Edit"]</button>
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(p)">@Loc["App_Delete"]</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => ToggleQr(p.Id)">
                            @(_qrId == p.Id ? "Teilen ausblenden" : "Teilen / QR")
                        </button>
                        @if (Access.IsAdmin && p.IsLoginless)
                        {
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => StartAddLogin(p)">Login geben</button>
                        }
                    </div>

                    @if (_loginId == p.Id)
                    {
                        <div class="person-login glass">
                            <span class="wl-muted">Anmeldedaten vergeben für @p.DisplayName:</span>
                            <input class="form-control" placeholder="Benutzername" @bind="_loginUser" />
                            <input class="form-control" type="password" placeholder="Passwort (min. 8 Zeichen)" @bind="_loginPw" />
                            <div class="person-actions">
                                <button class="btn btn-primary btn-sm" @onclick="() => SaveLoginAsync(p)"
                                        disabled="@(string.IsNullOrWhiteSpace(_loginUser) || (_loginPw?.Length ?? 0) < 8)">Speichern</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _loginId = null">Abbrechen</button>
                            </div>
                            @if (_loginError is not null) { <span class="login-error">@_loginError</span> }
                        </div>
                    }

                    @if (_qrId == p.Id)
                    {
                        <div class="person-qr">
                            <QrCode Value="@ShareUrl(p)" Size="180" />
                            <span class="wl-muted">Im anderen Haushalt scannen, um @p.DisplayName zu übernehmen.</span>
                            <input class="form-control person-link" readonly value="@ShareUrl(p)" @onfocus="SelectAll" />
                            <div class="person-actions">
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => CopyAsync(p)">
                                    @(_copiedId == p.Id ? "Link kopiert ✓" : "Link kopieren")
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => ShareAsync(p)">Teilen</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        <p class="wl-muted">Teile den Link einer Person mit einem anderen Haushalt. Dort kann sie übernommen werden – danach sehen beide Haushalte ihre gemeinsamen Ausleihen.</p>
    }
}

</ModuleGuard>

@code {
    private List<PersonCardDto> _people = new();
    private List<LinkedHouseholdDto> _linked = new();
    private string? _copiedId;
    private string? _qrId;
    private bool _loading = true;

    // Add/edit form.
    private SavePersonRequest? _edit;
    private string? _error;

    // Admin login-upgrade form.
    private string? _loginId;
    private string _loginUser = "";
    private string _loginPw = "";
    private string? _loginError;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _people = await PersonsSvc.GetAllAsync();
        _linked = await PersonsSvc.GetLinkedHouseholdsAsync();
        StateHasChanged();
    }

    private string ShareUrl(PersonCardDto p) => $"{Navigation.BaseUri.TrimEnd('/')}/persons/link/{p.LinkToken}";

    private void ToggleQr(string id) => _qrId = _qrId == id ? null : id;

    private void StartCreate()
    {
        _edit = new SavePersonRequest();
        _error = null;
    }

    private void StartEdit(PersonCardDto p)
    {
        _edit = new SavePersonRequest
        {
            Id = p.Id, FirstName = p.FirstName, LastName = p.LastName,
            Nickname = p.Nickname, Email = p.Email, Phone = p.Phone
        };
        _error = null;
    }

    private async Task SaveAsync()
    {
        if (_edit is null) return;
        var result = await PersonsSvc.SaveAsync(_edit);
        if (result.Success) { _edit = null; await ReloadAsync(); }
        else { _error = result.Error ?? "Speichern fehlgeschlagen."; }
    }

    private async Task DeleteAsync(PersonCardDto p)
    {
        if (await PersonsSvc.DeleteAsync(p.Id)) { await ReloadAsync(); }
    }

    private void StartAddLogin(PersonCardDto p)
    {
        _loginId = p.Id; _loginUser = ""; _loginPw = ""; _loginError = null;
    }

    private async Task SaveLoginAsync(PersonCardDto p)
    {
        var result = await PersonsSvc.AddLoginAsync(p.Id, new AddLoginRequest { UserName = _loginUser, Password = _loginPw });
        if (result.Success) { _loginId = null; await ReloadAsync(); }
        else { _loginError = result.Error ?? "Fehlgeschlagen."; }
    }

    private async Task SelectAll(FocusEventArgs _) => await JS.InvokeVoidAsync("reviaSelectAll");

    private async Task CopyAsync(PersonCardDto p)
    {
        var ok = await JS.InvokeAsync<bool>("reviaCopy", ShareUrl(p));
        _copiedId = ok ? p.Id : null;
        StateHasChanged();
    }

    private async Task ShareAsync(PersonCardDto p)
    {
        // Native share sheet (incl. AirDrop where available); falls back to copy.
        var shared = await JS.InvokeAsync<bool>("reviaShare", $"{p.DisplayName} übernehmen", ShareUrl(p));
        if (!shared) { await CopyAsync(p); }
    }
}
