@page "/persons"
@attribute [Authorize]
@using PrivateLibrary.Client.Features.Persons
@using PrivateLibrary.Client.Offline
@using PrivateLibrary.Shared.Persons
@inject PersonsClientService PersonsSvc
@inject ConnectivityService Connectivity
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<PrivateLibrary.Client.Resources.AppStrings> Loc

<PageTitle>Personen – Revia</PageTitle>

<ModuleGuard ModuleKey="persons">

<div class="wl-head">
    <h1>@Loc["Page_Persons"]</h1>
    @if (!Connectivity.IsOnline) { <span class="wl-offline">⚡ Offline</span> }
</div>

@if (_loading)
{
    <p class="wl-muted">Lade…</p>
}
else
{
    @if (_linked.Count > 0)
    {
        <div class="glass linked-households">
            <span class="wl-muted">Verknüpfte Haushalte (geteilte Ausleihen):</span>
            @foreach (var h in _linked) { <span class="badge">@h.Name</span> }
        </div>
    }

    @if (_people.Count == 0)
    {
        <p class="wl-muted">Keine Personen.</p>
    }
    else
    {
        <div class="person-grid">
            @foreach (var p in _people)
            {
                <div class="person-card glass" @key="p.Id">
                    <div class="person-name">@p.DisplayName</div>
                    @if (!string.IsNullOrWhiteSpace(p.Email)) { <div class="wl-muted">@p.Email</div> }
                    @if (!string.IsNullOrWhiteSpace(p.Phone)) { <div class="wl-muted">@p.Phone</div> }
                    <div class="person-actions">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => ToggleQr(p.Id)">
                            @(_qrId == p.Id ? "QR ausblenden" : "QR-Code")
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => CopyAsync(p)">
                            @(_copiedId == p.Id ? "Link kopiert ✓" : "Link kopieren")
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => ShareAsync(p)">Teilen</button>
                    </div>
                    @if (_qrId == p.Id)
                    {
                        <div class="person-qr">
                            <QrCode Value="@ShareUrl(p)" Size="180" />
                            <span class="wl-muted">Im anderen Haushalt scannen, um @p.DisplayName zu übernehmen.</span>
                        </div>
                    }
                </div>
            }
        </div>
        <p class="wl-muted">Teile den Link einer Person mit einem anderen Haushalt. Dort kann sie übernommen werden – danach sehen beide Haushalte ihre gemeinsamen Ausleihen.</p>
    }
}

</ModuleGuard>

@code {
    private List<PersonCardDto> _people = new();
    private List<LinkedHouseholdDto> _linked = new();
    private string? _copiedId;
    private string? _qrId;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _people = await PersonsSvc.GetAllAsync();
        _linked = await PersonsSvc.GetLinkedHouseholdsAsync();
        _loading = false;
    }

    private string ShareUrl(PersonCardDto p) => $"{Navigation.BaseUri.TrimEnd('/')}/persons/link/{p.LinkToken}";

    private void ToggleQr(string id) => _qrId = _qrId == id ? null : id;

    private async Task CopyAsync(PersonCardDto p)
    {
        var ok = await JS.InvokeAsync<bool>("reviaCopy", ShareUrl(p));
        _copiedId = ok ? p.Id : null;
        StateHasChanged();
    }

    private async Task ShareAsync(PersonCardDto p)
    {
        // Native share sheet (incl. AirDrop where available); falls back to copy.
        var shared = await JS.InvokeAsync<bool>("reviaShare", $"{p.DisplayName} übernehmen", ShareUrl(p));
        if (!shared) { await CopyAsync(p); }
    }
}
