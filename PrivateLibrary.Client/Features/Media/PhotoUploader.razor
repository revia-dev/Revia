@using PrivateLibrary.Client.Offline
@using PrivateLibrary.Shared.Media
@inject ConnectivityService Connectivity

@if (Connectivity.IsOnline)
{
    <div class="photo-uploader">
        <label class="wl-muted">@Label</label>
        <InputFile OnChange="OnSelected" accept="image/*" multiple="@Multiple" />
        @if (_busy) { <span class="wl-muted">Lädt…</span> }
        @if (_error is not null) { <span class="login-error">@_error</span> }
    </div>
}
else
{
    <span class="wl-muted" title="Fotos können nur online hochgeladen werden">📷 offline</span>
}

@code {
    /// <summary>Called once per chosen file with its upload payload. Return true if
    /// the upload succeeded (so the uploader can report a per-file failure).</summary>
    [Parameter, EditorRequired] public Func<UploadPhotoRequest, Task<bool>>? OnUpload { get; set; }
    [Parameter] public EventCallback OnUploaded { get; set; }
    [Parameter] public string Label { get; set; } = "Foto hinzufügen";
    [Parameter] public bool Multiple { get; set; } = true;
    [Parameter] public long MaxBytes { get; set; } = 8 * 1024 * 1024;

    private bool _busy;
    private string? _error;

    private async Task OnSelected(InputFileChangeEventArgs e)
    {
        if (OnUpload is null) return;
        _busy = true; _error = null;
        var anyFailed = false;

        foreach (var file in e.GetMultipleFiles(maximumFileCount: 10))
        {
            if (file.Size > MaxBytes) { _error = $"„{file.Name}" + "“ ist zu groß."; anyFailed = true; continue; }
            try
            {
                using var ms = new MemoryStream();
                await file.OpenReadStream(MaxBytes).CopyToAsync(ms);
                var request = new UploadPhotoRequest
                {
                    Base64 = Convert.ToBase64String(ms.ToArray()),
                    ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType,
                    FileName = file.Name
                };
                if (!await OnUpload(request)) { anyFailed = true; }
            }
            catch { anyFailed = true; }
        }

        _busy = false;
        if (anyFailed && _error is null) { _error = "Mindestens ein Foto konnte nicht hochgeladen werden."; }
        await OnUploaded.InvokeAsync();
    }
}
