@using PrivateLibrary.Shared.Analytics
@inject AnalyticsClientService Analytics

<section class="an-board">
    <div class="an-head">
        <h2 class="ui-section-title">Analysen</h2>
        @if (Analytics.IsOnline)
        {
            <button class="btn btn-primary btn-sm" @onclick="StartCreate">Neue Analyse</button>
        }
        else
        {
            <span class="wl-muted">offline – nur Ansicht</span>
        }
    </div>

    @if (_edit is not null)
    {
        <div class="an-editor glass">
            <div class="game-form">
                <div class="game-field game-wide"><label>Name</label>
                    <input class="form-control" maxlength="80" @bind="_edit.Name" @bind:event="oninput"
                           placeholder="z. B. Meist ausgeliehene Dinge" /></div>
                <div class="game-field game-wide"><label>Analyse</label>
                    <select class="form-control" @bind="_selectedMetric">
                        @foreach (var m in _metrics) { <option value="@m.Key">@m.Label</option> }
                    </select>
                    @if (CurrentMetric is not null) { <small class="wl-muted">@CurrentMetric.Description</small> }
                </div>
                @if (CurrentMetric is not null)
                {
                    foreach (var opt in CurrentMetric.Options)
                    {
                        <div class="game-field"><label>@opt.Label</label>
                            <input class="form-control" type="number" min="1" max="50"
                                   value="@GetOption(opt)" @onchange="e => SetOption(opt.Key, e.Value?.ToString())" /></div>
                    }
                }
            </div>
            <div class="game-actions">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@string.IsNullOrWhiteSpace(_edit.Name)">Speichern</button>
                <button class="btn btn-outline-secondary" @onclick="() => _edit = null">Abbrechen</button>
            </div>
            @if (_error is not null) { <div class="login-error">@_error</div> }
        </div>
    }

    @if (_widgets.Count == 0 && _edit is null)
    {
        <p class="wl-muted">Noch keine Analysen.</p>
    }
    else
    {
        <div class="an-grid">
            @for (var i = 0; i < _widgets.Count; i++)
            {
                var index = i;
                var w = _widgets[index];
                <article class="an-card glass" @key="w.Id">
                    <header class="an-card-head">
                        <span class="an-card-title">@w.Name</span>
                        @if (Analytics.IsOnline)
                        {
                            <span class="an-card-actions">
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(index == 0)" @onclick="() => MoveAsync(w.Id, -1)">↑</button>
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(index == _widgets.Count - 1)" @onclick="() => MoveAsync(w.Id, 1)">↓</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => StartEdit(w)">✎</button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(w.Id)">×</button>
                            </span>
                        }
                    </header>
                    @if (w.Rows.Count == 0)
                    {
                        <div class="wl-muted">@(w.Empty ?? "Keine Daten.")</div>
                    }
                    else
                    {
                        var max = w.Rows.Max(r => r.Value);
                        <ul class="an-rows">
                            @foreach (var row in w.Rows)
                            {
                                <li class="an-row">
                                    <span class="an-row-label" title="@row.Label">@row.Label</span>
                                    <span class="an-bar-wrap"><span class="an-bar" style="width:@BarWidth(row.Value, max)%"></span></span>
                                    <span class="an-row-value">@FormatValue(row)</span>
                                </li>
                            }
                        </ul>
                    }
                </article>
            }
        </div>
    }
</section>

@code {
    private List<AnalyticsWidgetDto> _widgets = new();
    private List<AnalyticsMetricDto> _metrics = new();
    private SaveAnalyticsWidgetRequest? _edit;
    private string _selectedMetric = "";
    private Dictionary<string, string> _options = new();
    private string? _error;

    private AnalyticsMetricDto? CurrentMetric => _metrics.FirstOrDefault(m => m.Key == _selectedMetric);

    protected override async Task OnInitializedAsync()
    {
        _metrics = await Analytics.GetMetricsAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _widgets = await Analytics.GetWidgetsAsync();
        StateHasChanged();
    }

    private void StartCreate()
    {
        _edit = new SaveAnalyticsWidgetRequest();
        _selectedMetric = _metrics.FirstOrDefault()?.Key ?? "";
        _options = new();
        _error = null;
    }

    private void StartEdit(AnalyticsWidgetDto w)
    {
        _edit = new SaveAnalyticsWidgetRequest { Id = w.Id, Name = w.Name, Metric = w.Metric };
        _selectedMetric = w.Metric;
        _options = new(w.Options);
        _error = null;
    }

    private string? GetOption(AnalyticsOptionDto opt) => _options.TryGetValue(opt.Key, out var v) ? v : opt.Default;
    private void SetOption(string key, string? value) => _options[key] = value ?? "";

    private async Task SaveAsync()
    {
        if (_edit is null || string.IsNullOrWhiteSpace(_edit.Name)) return;
        _edit.Metric = _selectedMetric;
        var allowed = CurrentMetric?.Options.Select(o => o.Key).ToHashSet() ?? new();
        _edit.Options = _options.Where(kv => allowed.Contains(kv.Key)).ToDictionary(kv => kv.Key, kv => kv.Value);

        if (await Analytics.SaveAsync(_edit)) { _edit = null; await LoadAsync(); }
        else { _error = "Speichern fehlgeschlagen (offline?)."; }
    }

    private async Task DeleteAsync(int id) { if (await Analytics.DeleteAsync(id)) await LoadAsync(); }
    private async Task MoveAsync(int id, int delta) { if (await Analytics.MoveAsync(id, delta)) await LoadAsync(); }

    private static int BarWidth(double value, double max) => max <= 0 ? 0 : Math.Max(4, (int)Math.Round(value / max * 100));
    private static string FormatValue(AnalyticsRowDto row)
    {
        var num = row.Value == Math.Floor(row.Value) ? row.Value.ToString("0") : row.Value.ToString("0.##");
        return string.IsNullOrEmpty(row.ValueSuffix) ? num : $"{num} {row.ValueSuffix}";
    }
}
