@page "/wishlists"
@using Revia.Data
@using Revia.Modules.Wishlists
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject WishlistService WishlistService
@inject Revia.Modules.Lending.Services.ToastService ToastService
@inject Revia.Services.PermissionService Permissions
@inject NavigationManager Navigation

<PageTitle>Wunschzettel</PageTitle>

<div class="page-shell">
    <div class="glass-card page-header">
        <div>
            <h1>Wunschzettel</h1>
            <p>Alle Wunschzettel im Haushalt.</p>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="/wishlists/export.csv" target="_blank" rel="noopener">CSV-Export</a>
        </div>
    </div>

    @if (_canWrite)
    {
        <div class="glass-card ui-section">
            <h2 class="ui-section-title">Neuen Wunschzettel anlegen</h2>
            <div class="wishlist-add">
                <input class="form-control" placeholder="Bezeichnung (z. B. Geburtstag)" @bind="_newName" />
                <button type="button" class="btn btn-primary" @onclick="CreateAsync">Anlegen</button>
            </div>
        </div>
    }

    @{
        var visible = _showCompleted ? _wishlists : _wishlists.Where(w => !IsFullyFulfilled(w)).ToList();
        var hiddenCount = _wishlists.Count(IsFullyFulfilled);
    }

    @if (hiddenCount > 0)
    {
        <div class="wishlist-toolbar">
            <button type="button" class="btn btn-outline-secondary" @onclick="() => _showCompleted = !_showCompleted">
                @(_showCompleted ? "Erledigte ausblenden" : $"Erledigte anzeigen ({hiddenCount})")
            </button>
        </div>
    }

    @if (visible.Count == 0)
    {
        <div class="glass-card ui-section text-muted">
            @(_wishlists.Count == 0 ? "Noch keine Wunschzettel vorhanden." : "Alle Wunschzettel sind erledigt.")
        </div>
    }
    else
    {
        <div class="wishlist-grid">
            @foreach (var w in visible)
            {
                <a class="wishlist-card" href="@($"/wishlists/{w.Id}")" @key="w.Id">
                    <div class="wishlist-card-title">
                        @w.Name
                        @if (IsFullyFulfilled(w)) { <span class="badge text-bg-success">erledigt</span> }
                    </div>
                    <div class="wishlist-card-owner">@(w.OwnerUser?.DisplayName ?? "—")</div>
                    <div class="wishlist-card-meta">
                        @w.Items.Count Wünsche
                        @{ var open = w.Items.Count(i => !i.IsFulfilled); }
                        @if (open != w.Items.Count) { <span>· @open offen</span> }
                    </div>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<Wishlist> _wishlists = new();
    private string _newName = string.Empty;
    private bool _canWrite = true;
    private bool _showCompleted;

    private static bool IsFullyFulfilled(Wishlist w)
        => w.Items.Count > 0 && w.Items.All(i => i.IsFulfilled);

    protected override async Task OnInitializedAsync()
    {
        var access = await Permissions.GetAccessAsync(AppModules.Wishlists);
        if (!access.CanRead)
        {
            Navigation.NavigateTo("/");
            return;
        }
        _canWrite = access.CanWrite;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _wishlists = (await WishlistService.GetHouseholdWishlistsAsync()).ToList();
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName)) { ToastService.Error("Bitte eine Bezeichnung eingeben."); return; }
        await WishlistService.CreateWishlistAsync(_newName);
        _newName = string.Empty;
        ToastService.Success("Wunschzettel angelegt.");
        await ReloadAsync();
    }
}
