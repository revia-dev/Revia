@page "/lending/edit/{Id:int}"
@page "/lending/new"
@using Microsoft.AspNetCore.Components.Forms
@using Revia.Data
@using Revia.Modules.Lending.Models
@inject Revia.Modules.Lending.Services.ILendingService LendingService
@inject Revia.Modules.Lending.Services.IPersonService PersonService
@inject Revia.Modules.Lending.Services.ToastService ToastService
@inject NotificationService Notifications
@inject Revia.Services.PermissionService Permissions
@inject NavigationManager Navigation

<PageTitle>@(_id.HasValue ? "Ausleih-Eintrag bearbeiten" : "Neuer Ausleih-Eintrag")</PageTitle>

<div class="page-shell">
    <div class="glass-card page-header">
        <div>
            <h1>@(_id.HasValue ? "Ausleih-Eintrag bearbeiten" : "Neuer Ausleih-Eintrag")</h1>
            <p>Ausleih-Eintrag erfassen und bearbeiten.</p>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-secondary btn-modern" href="/lending/persons/new">Neue Person</a>
            <a class="btn btn-outline-secondary btn-modern" href="/lending/categories">Kategorien</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="glass-card loading-card">@_loadError</div>
    }
    else if (_model is null)
    {
        <div class="glass-card loading-card">Lade Formular...</div>
    }
    else
    {
        <EditForm Model="@_model" OnValidSubmit="SaveAsync" FormName="lending-edit-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary-errors" />

            <div class="glass-card form-shell">
                <div class="form-grid">
                    <div class="field">
                        <label for="title">Titel</label>
                        <InputText id="title" class="form-control visible-input" @bind-Value="_model.Title" />
                        <ValidationMessage For="@(() => _model.Title)" />
                    </div>

                    <div class="field field-wide">
                        <label for="new-item-name">Gegenstände</label>

                        <div class="item-add-row">
                            <InputText id="new-item-name" class="form-control visible-input" @bind-Value="_model.NewItemName" />
                            <button type="button" class="btn btn-secondary btn-modern" @onclick="AddItemToGrid">Hinzufügen</button>
                        </div>

                        @if (_model.ItemNames.Count > 0)
                        {
                            <div class="item-grid">
                                @for (var i = 0; i < _model.ItemNames.Count; i++)
                                {
                                    var index = i;
                                    var itemName = _model.ItemNames[index];
                                    <div class="item-grid-row" @key="itemName + index">
                                        <div class="item-grid-name">@itemName</div>
                                        <button type="button"
                                                class="btn btn-outline-secondary btn-modern item-remove-btn"
                                                @onclick="() => RemoveItem(index)">
                                            Entfernen
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-hint">Noch keine Gegenstände hinzugefügt.</div>
                        }

                        <ValidationMessage For="@(() => _model.ItemNames)" />
                    </div>

                    <div class="field">
                        <label for="category-select">Vorhandene Kategorie</label>
                        <select id="category-select" class="form-select visible-input" @bind="_selectedCategoryIdString">
                            <option value="">Bitte wählen</option>
                            @foreach (var category in _categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="new-category">Neue Kategorie</label>
                        <div class="item-add-row">
                            <InputText id="new-category" class="form-control visible-input" @bind-Value="_newCategoryName" />
                            <button type="button" class="btn btn-secondary btn-modern" @onclick="AddNewCategoryAsync">Hinzufügen</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_categoryMessage))
                        {
                            <div class="empty-hint">@_categoryMessage</div>
                        }
                    </div>

                    <div class="field">
                        <label for="lender">Verleiher</label>
                        <InputSelect id="lender" class="form-select visible-input" @bind-Value="_model.LenderId">
                            <option value="">Bitte wählen</option>
                            @foreach (var person in _people)
                            {
                                <option value="@person.Id">@person.DisplayName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _model.LenderId)" />
                    </div>

                    <div class="field">
                        <label for="borrower">Entleiher</label>
                        <InputSelect id="borrower" class="form-select visible-input" @bind-Value="_model.BorrowerId">
                            <option value="">Bitte wählen</option>
                            @foreach (var person in _people)
                            {
                                <option value="@person.Id">@person.DisplayName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _model.BorrowerId)" />
                    </div>

                    <div class="field">
                        <label for="loan-date">Ausleihdatum</label>
                        <InputDate id="loan-date" class="form-control visible-input" @bind-Value="_model.LoanDate" />
                        <ValidationMessage For="@(() => _model.LoanDate)" />
                    </div>

                    <div class="field">
                        <label for="due-date">Geplantes Rückgabedatum</label>
                        <InputDate id="due-date" class="form-control visible-input" @bind-Value="_model.DueDate" />
                        <ValidationMessage For="@(() => _model.DueDate)" />
                    </div>

                    <div class="field">
                        <label for="returned-at">Tatsächliche Rückgabe</label>
                        <InputDate id="returned-at" class="form-control visible-input" @bind-Value="_model.ReturnedAt" />
                        <ValidationMessage For="@(() => _model.ReturnedAt)" />
                    </div>

                    <div class="field">
                        <label for="status">Status</label>
                        <InputSelect id="status" class="form-select visible-input" @bind-Value="_model.Status">
                            <option value="@LendingEntryStatus.Active">Aktiv</option>
                            <option value="@LendingEntryStatus.Overdue">Überfällig</option>
                            <option value="@LendingEntryStatus.Returned">Zurückgegeben</option>
                            <option value="@LendingEntryStatus.Lost">Verloren</option>
                            <option value="@LendingEntryStatus.GivenAway">Verschenkt</option>
                        </InputSelect>
                    </div>

                    <div class="field field-wide">
                        <label for="description">Beschreibung</label>
                        <InputTextArea id="description" class="form-control visible-input" rows="4" @bind-Value="_model.Description" />
                        <ValidationMessage For="@(() => _model.Description)" />
                    </div>

                    <div class="field field-wide">
                        <label for="notes">Notizen</label>
                        <InputTextArea id="notes" class="form-control visible-input" rows="4" @bind-Value="_model.Notes" />
                        <ValidationMessage For="@(() => _model.Notes)" />
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-modern">@(_id.HasValue ? "Änderungen speichern" : "Eintrag anlegen")</button>
                    <a class="btn btn-secondary btn-modern" href="/lending">Abbrechen</a>
                </div>
            </div>
        </EditForm>

        <div class="glass-card form-shell">
            <div>
                <h3 class="ui-section-title">Fotos</h3>
                <p class="section-subtitle">Füge Fotos per Kamera oder aus der Mediathek hinzu.</p>
            </div>

            @if (_id.HasValue)
            {
                <div class="photo-upload">
                    <MediaUpload OnChange="OnPhotosSelectedAsync" OnCapture="OnPhotoCapturedAsync" Multiple="true" />
                    @if (_uploadingPhotos)
                    {
                        <div class="photo-empty"><span class="spinner spinner-sm"></span> Fotos werden hochgeladen ...</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_photoError))
                    {
                        <div class="login-error">@_photoError</div>
                    }
                </div>

                @if (_photos.Count > 0)
                {
                    <div class="photo-grid">
                        @foreach (var photo in _photos)
                        {
                            <div class="photo-thumb" @key="photo.Id">
                                <img src="@($"/lending/photos/{photo.Id}")" alt="@(photo.OriginalName ?? "Foto")" loading="lazy" />
                                <IconButton IconName="trash"
                                            AriaLabel="Foto entfernen"
                                            Variant="btn-danger"
                                            CssClass="photo-thumb-remove"
                                            OnClick="() => RemovePhotoAsync(photo.Id)" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="photo-empty">Noch keine Fotos hinzugefügt.</div>
                }
            }
            else
            {
                <div class="photo-empty">Speichere den Eintrag zuerst, um Fotos hinzufügen zu können.</div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private int? _id;
    private string? _loadError;
    private LendingEntryEditModel? _model;
    private IReadOnlyList<ApplicationUser> _people = Array.Empty<ApplicationUser>();
    private IReadOnlyList<LendingCategory> _categories = Array.Empty<LendingCategory>();
    private string _selectedCategoryIdString = string.Empty;
    private string _newCategoryName = string.Empty;
    private string? _categoryMessage;

    private readonly List<LendingPhoto> _photos = new();
    private bool _uploadingPhotos;
    private string? _photoError;

    private const long MaxPhotoBytes = 15 * 1024 * 1024;
    private const int MaxPhotoCount = 20;

    protected override async Task OnParametersSetAsync()
    {
        if (!await Permissions.CanWriteAsync(AppModules.Lending))
        {
            Navigation.NavigateTo("/lending");
            return;
        }

        _loadError = null;
        _id = Id;

        try
        {
            _people = await PersonService.GetLookupAsync();
            await ReloadCategoriesAsync();

            if (_id.HasValue)
            {
                var item = await LendingService.GetByIdAsync(_id.Value);
                if (item is null)
                {
                    Navigation.NavigateTo("/lending");
                    return;
                }

                var itemNames = item.Items
                    .OrderBy(x => x.SortOrder)
                    .Select(x => x.Name)
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .ToList();

                if (itemNames.Count == 0 && !string.IsNullOrWhiteSpace(item.ItemName))
                {
                    itemNames.Add(item.ItemName);
                }

                var selectedCategoryId = item.CategoryLinks
                    .Select(x => x.LendingCategoryId)
                    .FirstOrDefault();

                _selectedCategoryIdString = selectedCategoryId > 0 ? selectedCategoryId.ToString() : string.Empty;

                _model = new LendingEntryEditModel
                {
                    Id = item.Id,
                    Title = item.Title,
                    Description = item.Description,
                    ItemName = item.ItemName,
                    Category = item.Category,
                    ItemNames = itemNames,
                    LenderId = item.LenderId ?? string.Empty,
                    BorrowerId = item.BorrowerId ?? string.Empty,
                    LoanDate = item.LoanDate,
                    DueDate = item.DueDate,
                    ReturnedAt = item.ReturnedAt,
                    Status = item.Status,
                    Notes = item.Notes,
                    NewItemName = string.Empty
                };

                _photos.Clear();
                _photos.AddRange(item.Photos.OrderBy(x => x.SortOrder).ThenBy(x => x.Id));
            }
            else
            {
                _selectedCategoryIdString = string.Empty;
                _model = new LendingEntryEditModel
                {
                    LoanDate = DateTime.Today,
                    Status = LendingEntryStatus.Active,
                    ItemNames = new List<string>(),
                    NewItemName = string.Empty
                };
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Formular konnte nicht geladen werden: {ex.Message}";
            _model = null;
        }
    }

    private void AddItemToGrid()
    {
        if (_model is null)
        {
            return;
        }

        var normalizedName = (_model.NewItemName ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(normalizedName))
        {
            return;
        }

        if (!_model.ItemNames.Any(x => string.Equals(x, normalizedName, StringComparison.OrdinalIgnoreCase)))
        {
            _model.ItemNames.Add(normalizedName);
        }

        _model.NewItemName = string.Empty;
        StateHasChanged();
    }

    private void RemoveItem(int index)
    {
        if (_model is null)
        {
            return;
        }

        if (index < 0 || index >= _model.ItemNames.Count)
        {
            return;
        }

        _model.ItemNames.RemoveAt(index);
        StateHasChanged();
    }

    private async Task AddNewCategoryAsync()
    {
        var normalizedName = (_newCategoryName ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(normalizedName))
        {
            _categoryMessage = "Bitte gib einen Kategorienamen ein.";
            return;
        }

        try
        {
            var category = await LendingService.GetOrCreateCategoryAsync(normalizedName);
            await ReloadCategoriesAsync();
            _selectedCategoryIdString = category.Id.ToString();
            _newCategoryName = string.Empty;
            _categoryMessage = $"Kategorie '{category.Name}' wurde ausgewählt.";
        }
        catch (Exception ex)
        {
            _categoryMessage = ex.Message;
        }
    }

    private async Task ReloadCategoriesAsync()
    {
        _categories = await LendingService.GetCategoriesAsync();
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        var normalizedItems = _model.ItemNames
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select((name, index) => new LendingItem
            {
                Name = name.Trim(),
                SortOrder = index
            })
            .ToList();

        int.TryParse(_selectedCategoryIdString, out var selectedCategoryId);
        var selectedCategory = _categories.FirstOrDefault(x => x.Id == selectedCategoryId);
        var normalizedCategory = selectedCategory?.Name;

        var entity = new LendingEntry
        {
            Id = _model.Id,
            Title = _model.Title,
            Description = _model.Description,
            ItemName = normalizedItems.FirstOrDefault()?.Name ?? string.Empty,
            Category = normalizedCategory,
            LenderId = _model.LenderId ?? string.Empty,
            BorrowerId = _model.BorrowerId ?? string.Empty,
            LoanDate = _model.LoanDate ?? DateTime.Today,
            DueDate = _model.DueDate,
            ReturnedAt = _model.ReturnedAt,
            Notes = _model.Notes,
            Status = _model.Status,
            Items = normalizedItems,
            CategoryLinks = selectedCategoryId > 0
                ? new List<LendingEntryCategory> { new() { LendingCategoryId = selectedCategoryId } }
                : new List<LendingEntryCategory>()
        };

        if (entity.Id == 0)
        {
            var created = await LendingService.CreateAsync(entity);
            ToastService.Success("Eintrag angelegt. Du kannst jetzt Fotos hinzufügen.");

            var borrowerName = _people.FirstOrDefault(p => p.Id == entity.BorrowerId)?.DisplayName ?? "jemanden";
            var itemTitle = entity.Title ?? normalizedItems.FirstOrDefault()?.Name ?? "Gegenstand";
            await Notifications.Notify(AppNotification.LendingCreated(itemTitle, borrowerName, created.Id));

            // Go to the edit page (not details) so photos can be added right away.
            Navigation.NavigateTo("/lending/edit/" + created.Id);
        }
        else
        {
            await LendingService.UpdateAsync(entity);
            ToastService.Success("Änderungen gespeichert.");
            Navigation.NavigateTo("/lending/" + entity.Id);
        }
    }

    private async Task OnPhotosSelectedAsync(InputFileChangeEventArgs e)
    {
        if (!_id.HasValue)
        {
            return;
        }

        _photoError = null;
        _uploadingPhotos = true;

        try
        {
            foreach (var file in e.GetMultipleFiles(MaxPhotoCount))
            {
                if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                {
                    _photoError = "Es werden nur Bilddateien unterstützt.";
                    continue;
                }

                try
                {
                    await using var stream = file.OpenReadStream(MaxPhotoBytes);
                    var photo = await LendingService.AddPhotoAsync(_id.Value, stream, file.ContentType, file.Name);
                    _photos.Add(photo);
                }
                catch (Exception ex)
                {
                    _photoError = $"'{file.Name}' konnte nicht hochgeladen werden: {ex.Message}";
                }
            }
        }
        finally
        {
            _uploadingPhotos = false;
        }
    }

    private async Task OnPhotoCapturedAsync(CapturedPhoto photo)
    {
        if (!_id.HasValue)
        {
            return;
        }

        _photoError = null;
        _uploadingPhotos = true;

        try
        {
            await using var stream = photo.OpenReadStream();
            var added = await LendingService.AddPhotoAsync(_id.Value, stream, photo.ContentType, photo.FileName);
            _photos.Add(added);
        }
        catch (Exception ex)
        {
            _photoError = $"Foto konnte nicht hochgeladen werden: {ex.Message}";
        }
        finally
        {
            _uploadingPhotos = false;
        }
    }

    private async Task RemovePhotoAsync(int photoId)
    {
        var removed = await LendingService.RemovePhotoAsync(photoId);
        if (removed)
        {
            _photos.RemoveAll(x => x.Id == photoId);
            ToastService.Success("Foto entfernt.");
        }
    }
}
