@page "/games/{GameId:int}/matches/new"
@page "/games/{GameId:int}/matches/{MatchId:int}"
@using Revia.Data
@using Revia.Modules.Games
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize]
@inject GameService GameService
@inject Revia.Modules.Lending.Services.IPersonService PersonService
@inject Revia.Modules.Lending.Services.ToastService ToastService
@inject Revia.Services.PermissionService Permissions
@inject NavigationManager Navigation

<PageTitle>Partie</PageTitle>

<div class="page-shell">
    <div class="glass-card page-header">
        <div>
            <h1>@(MatchId is null ? "Neue Partie" : "Partie")</h1>
            <p>@(_game?.Name)</p>
        </div>
        <a class="btn btn-secondary" href="@($"/games/{GameId}")">Zurück</a>
    </div>

    @if (_game is null || _loading)
    {
        <div class="glass-card">Lade ...</div>
    }
    else
    {
        var locked = _match?.IsCompleted == true;
        var unit = _game.ScoreDefinitions.FirstOrDefault(d => d.Id == _scoreDefinitionId)?.Unit;

        <div class="glass-card form-shell">
            @if (locked)
            {
                <div class="match-locked">Diese Partie ist abgeschlossen und schreibgeschützt.</div>
            }

            <div class="form-grid">
                <div class="field field-wide">
                    <label>Titel (optional)</label>
                    <input class="form-control" @bind="_title" disabled="@locked" />
                </div>
                <div class="field">
                    <label>Datum</label>
                    <input type="date" class="form-control" @bind="_playedOn" @bind:format="yyyy-MM-dd" disabled="@locked" />
                </div>
                @if (_game.ScoreDefinitions.Count > 0)
                {
                    <div class="field">
                        <label>Score-Typ</label>
                        <select class="form-select" @bind="_scoreDefinitionId" disabled="@locked">
                            <option value="">— keiner —</option>
                            @foreach (var def in _game.ScoreDefinitions)
                            {
                                <option value="@def.Id">@def.Name@(string.IsNullOrWhiteSpace(def.Unit) ? "" : $" ({def.Unit})")</option>
                            }
                        </select>
                    </div>
                }
                <div class="field field-wide">
                    <label>Notizen</label>
                    <textarea class="form-control" rows="2" @bind="_notes" disabled="@locked"></textarea>
                </div>

                <div class="field field-wide">
                    <label>Personen &amp; Score@(string.IsNullOrWhiteSpace(unit) ? "" : $" ({unit})")</label>
                    <div class="match-players">
                        @foreach (var p in _persons)
                        {
                            <div class="match-player-row" @key="p.Id">
                                <label class="checkbox-field">
                                    <input type="checkbox" checked="@_selected.Contains(p.Id)" disabled="@locked"
                                           @onchange="e => TogglePerson(p.Id, (bool)e.Value!)" />
                                    <span>@p.DisplayName</span>
                                </label>
                                @if (_selected.Contains(p.Id))
                                {
                                    <input type="number" step="0.01" class="form-control match-player-score"
                                           placeholder="Score" disabled="@locked"
                                           value="@(_scores.TryGetValue(p.Id, out var sc) ? sc?.ToString() : null)"
                                           @onchange="e => SetScore(p.Id, e.Value?.ToString())" />
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="form-actions">
                @if (!locked)
                {
                    <button type="button" class="btn btn-primary btn-modern" @onclick="SaveAsync">Speichern</button>
                }
                @if (MatchId is not null)
                {
                    @if (!locked)
                    {
                        <button type="button" class="btn btn-success btn-modern" @onclick="() => SetCompletedAsync(true)">Abschließen</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary btn-modern" @onclick="() => SetCompletedAsync(false)">Wieder öffnen</button>
                    }
                    <button type="button" class="btn btn-outline-danger btn-modern" @onclick="DeleteAsync">Löschen</button>
                }
            </div>
        </div>

        @if (MatchId is not null && _match is not null)
        {
            <div class="glass-card ui-section ui-stack">
                <h2 class="ui-section-title">Bilder</h2>
                @if (!locked)
                {
                    <MediaUpload OnChange="OnPhotosSelected" OnCapture="OnPhotoCaptured" Multiple="true" />
                    @if (_uploading) { <div class="text-muted">Lade hoch ...</div> }
                }
                @if (_match.Photos.Count > 0)
                {
                    <div class="match-photo-grid">
                        @foreach (var photo in _match.Photos)
                        {
                            <div class="match-photo" @key="photo.Id">
                                <a href="@($"/games/matches/photo/{photo.Id}")" target="_blank" rel="noopener">
                                    <img src="@($"/games/matches/photo/{photo.Id}")" alt="" loading="lazy" />
                                </a>
                                @if (!locked)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemovePhotoAsync(photo.Id)">×</button>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted">Noch keine Bilder.</div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public int GameId { get; set; }
    [Parameter] public int? MatchId { get; set; }

    private Game? _game;
    private GameMatch? _match;
    private IReadOnlyList<ApplicationUser> _persons = Array.Empty<ApplicationUser>();
    private bool _loading = true;
    private bool _uploading;

    private string? _title;
    private DateTime _playedOn = DateTime.Today;
    private int? _scoreDefinitionId;
    private string? _notes;
    private readonly HashSet<string> _selected = new();
    private readonly Dictionary<string, double?> _scores = new();

    private const long MaxPhotoBytes = 15 * 1024 * 1024;

    protected override async Task OnParametersSetAsync()
    {
        if (!await Permissions.CanWriteAsync(AppModules.Games))
        {
            Navigation.NavigateTo("/games");
            return;
        }

        _loading = true;
        _game = await GameService.GetGameAsync(GameId);
        if (_game is null) { Navigation.NavigateTo("/games"); return; }

        _persons = await PersonService.GetLookupAsync();

        if (MatchId is not null)
        {
            _match = await GameService.GetMatchAsync(MatchId.Value);
            if (_match is null || _match.GameId != GameId) { Navigation.NavigateTo($"/games/{GameId}"); return; }

            _title = _match.Title;
            _playedOn = _match.PlayedOn;
            _scoreDefinitionId = _match.ScoreDefinitionId;
            _notes = _match.Notes;
            _selected.Clear();
            _scores.Clear();
            foreach (var p in _match.Participants)
            {
                _selected.Add(p.PersonId);
                _scores[p.PersonId] = p.Score;
            }
        }
        else
        {
            _scoreDefinitionId = _game.ScoreDefinitions.FirstOrDefault()?.Id;
        }

        _loading = false;
    }

    private void TogglePerson(string id, bool on)
    {
        if (on) _selected.Add(id);
        else { _selected.Remove(id); _scores.Remove(id); }
    }

    private void SetScore(string id, string? raw)
    {
        _scores[id] = double.TryParse(raw, out var v) ? v : null;
    }

    private IEnumerable<MatchParticipantInput> BuildParticipants()
        => _selected.Select(id => new MatchParticipantInput(id, _scores.TryGetValue(id, out var s) ? s : null));

    private async Task SaveAsync()
    {
        try
        {
            if (MatchId is null)
            {
                var created = await GameService.CreateMatchAsync(GameId, new GameMatch
                {
                    Title = _title,
                    PlayedOn = _playedOn,
                    ScoreDefinitionId = _scoreDefinitionId,
                    Notes = _notes
                }, BuildParticipants());
                ToastService.Success("Partie angelegt.");
                Navigation.NavigateTo($"/games/{GameId}/matches/{created.Id}");
            }
            else
            {
                await GameService.UpdateMatchAsync(new GameMatch
                {
                    Id = MatchId.Value,
                    Title = _title,
                    PlayedOn = _playedOn,
                    ScoreDefinitionId = _scoreDefinitionId,
                    Notes = _notes
                }, BuildParticipants());
                ToastService.Success("Gespeichert.");
                _match = await GameService.GetMatchAsync(MatchId.Value);
            }
        }
        catch (Exception ex)
        {
            ToastService.Error(ex.Message);
        }
    }

    private async Task SetCompletedAsync(bool completed)
    {
        if (MatchId is null) return;
        await GameService.SetMatchCompletedAsync(MatchId.Value, completed);
        _match = await GameService.GetMatchAsync(MatchId.Value);
    }

    private async Task DeleteAsync()
    {
        if (MatchId is null) return;
        await GameService.DeleteMatchAsync(MatchId.Value);
        ToastService.Success("Partie gelöscht.");
        Navigation.NavigateTo($"/games/{GameId}");
    }

    private async Task OnPhotosSelected(InputFileChangeEventArgs e)
    {
        if (MatchId is null) return;
        _uploading = true;
        try
        {
            foreach (var file in e.GetMultipleFiles(20))
            {
                if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) continue;
                await using var stream = file.OpenReadStream(MaxPhotoBytes);
                await GameService.AddMatchPhotoAsync(MatchId.Value, stream, file.ContentType, file.Name);
            }
            _match = await GameService.GetMatchAsync(MatchId.Value);
        }
        catch (Exception ex)
        {
            ToastService.Error(ex.Message);
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task OnPhotoCaptured(CapturedPhoto photo)
    {
        if (MatchId is null) return;
        _uploading = true;
        try
        {
            await using var stream = photo.OpenReadStream();
            await GameService.AddMatchPhotoAsync(MatchId.Value, stream, photo.ContentType, photo.FileName);
            _match = await GameService.GetMatchAsync(MatchId.Value);
        }
        catch (Exception ex)
        {
            ToastService.Error(ex.Message);
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task RemovePhotoAsync(int photoId)
    {
        await GameService.RemoveMatchPhotoAsync(photoId);
        if (MatchId is not null) _match = await GameService.GetMatchAsync(MatchId.Value);
    }
}
