@page "/"
@using Revia.Modules.Lending.Models
@using Revia.Services
@inject Revia.Modules.Lending.Services.ILendingService LendingService
@inject Revia.Modules.Lending.Services.ToastService ToastService
@inject DashboardService DashboardService
@inject DashboardLayoutService LayoutService
@inject ModuleTileLayoutService TileService
@inject PermissionService Permissions
@inject AnalyticsService Analytics
@inject NotificationService Notifications

<PageTitle>Dashboard</PageTitle>

<div class="page-shell">
    <div class="page-header glass-card">
        <div class="dashboard-hero">
            <img class="dashboard-brand" src="/images/app-icon.png" alt="Revia" />
            <div>
                <h1>Dashboard</h1>
                <p>Übersicht über alle Module deines Haushalts.</p>
            </div>
        </div>
        <div class="header-actions">
            @if (_editLayout)
            {
                <button class="btn btn-primary" @onclick="StopEditingLayout">
                    <Icon Name="check-lg" /> <span>Fertig</span>
                </button>
                <button class="btn btn-outline-secondary" @onclick="ResetLayoutAsync" title="Auf Standard zurücksetzen">
                    Zurücksetzen
                </button>
            }
            else
            {
                <button class="btn btn-outline-secondary" @onclick="StartEditingLayout" title="Dashboard anpassen">
                    <Icon Name="pencil" /> <span>Anpassen</span>
                </button>
                <a class="btn btn-primary" href="/lending/new">Neu anlegen</a>
            }
        </div>
    </div>

    @if (_editLayout)
    {
        <div class="glass-card ui-section dashboard-customize">
            <div>
                <h2 class="ui-section-title">Dashboard anpassen</h2>
                <p class="section-subtitle">Blende Bereiche ein oder aus und ändere ihre Reihenfolge. Deine Einstellung wird automatisch gespeichert.</p>
            </div>

            <div class="dashboard-customize-group-title">Bereiche</div>
            <ul class="dashboard-customize-list">
                @for (var i = 0; i < _layout.Count; i++)
                {
                    var index = i;
                    var row = _layout[index];
                    <li class="dashboard-customize-row @(row.Visible ? "" : "is-hidden")">
                        <span class="dashboard-customize-name">@row.Label</span>
                        <div class="dashboard-customize-actions">
                            <IconButton IconName="arrow-up" AriaLabel="Nach oben"
                                        Disabled="index == 0"
                                        OnClick="() => MoveSectionAsync(index, -1)" />
                            <IconButton IconName="arrow-down" AriaLabel="Nach unten"
                                        Disabled="index == _layout.Count - 1"
                                        OnClick="() => MoveSectionAsync(index, 1)" />
                            <IconButton IconName="@(row.Visible ? "eye" : "eye-slash")"
                                        AriaLabel="@(row.Visible ? "Ausblenden" : "Einblenden")"
                                        CssClass="@(row.Visible ? "" : "btn-icon-muted")"
                                        OnClick="() => ToggleSectionAsync(index)" />
                        </div>
                    </li>
                }
            </ul>

            <div class="dashboard-customize-group-title">Modul-Kacheln</div>
            <ul class="dashboard-customize-list">
                @for (var i = 0; i < _tiles.Count; i++)
                {
                    var index = i;
                    var tile = _tiles[index];
                    <li class="dashboard-customize-row @(tile.Visible ? "" : "is-hidden")">
                        <span class="dashboard-customize-name">@tile.Label</span>
                        <div class="dashboard-customize-actions">
                            <IconButton IconName="arrow-up" AriaLabel="Nach oben"
                                        Disabled="index == 0"
                                        OnClick="() => MoveTileAsync(index, -1)" />
                            <IconButton IconName="arrow-down" AriaLabel="Nach unten"
                                        Disabled="index == _tiles.Count - 1"
                                        OnClick="() => MoveTileAsync(index, 1)" />
                            <IconButton IconName="@(tile.Visible ? "eye" : "eye-slash")"
                                        AriaLabel="@(tile.Visible ? "Ausblenden" : "Einblenden")"
                                        CssClass="@(tile.Visible ? "" : "btn-icon-muted")"
                                        OnClick="() => ToggleTileAsync(index)" />
                        </div>
                    </li>
                }
            </ul>
        </div>
    }

    @foreach (var section in _layout)
    {
        if (!section.Visible)
        {
            continue;
        }

        @SectionFragment(section.Key)
    }
</div>

<style>
    .dashboard-hero {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        min-width: 0;
    }

    .dashboard-brand {
        width: 4.5rem;
        height: 4.5rem;
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-md);
        object-fit: cover;
        flex-shrink: 0;
    }

    .dashboard-customize-list {
        list-style: none;
        margin: 0 0 0.5rem;
        padding: 0;
        display: grid;
        gap: 0.5rem;
    }

    .dashboard-customize-group-title {
        margin: 0.75rem 0 0.4rem;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--text-soft, #858585);
    }

    .dashboard-customize-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.6rem 0.85rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        background: var(--surface-soft);
    }

    .dashboard-customize-row.is-hidden {
        opacity: 0.55;
    }

    .dashboard-customize-name {
        font-weight: 600;
    }

    .dashboard-customize-actions {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .module-tiles {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 0.85rem;
    }

    .module-tile {
        display: block;
        padding: 1rem 1.1rem;
        text-decoration: none;
        color: var(--text);
        transition: transform 0.15s, border-color 0.15s;
    }

    .module-tile:hover {
        transform: translateY(-2px);
        border-color: var(--border-strong);
    }

    .module-tile-value {
        font-size: 1.8rem;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .module-tile-label {
        color: var(--text-muted);
        font-size: 0.85rem;
        margin-top: 0.2rem;
    }

    .dashboard-chart-layout {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: minmax(0, 2fr) minmax(220px, 1fr);
        align-items: center;
    }

    .dashboard-chart-bars {
        display: flex;
        align-items: end;
        justify-content: center;
        gap: 2rem;
        min-height: 260px;
        padding: 1rem;
        border-radius: var(--radius-md);
        border: 1px solid var(--border);
        background: var(--surface-soft);
    }

    .dashboard-chart-bar-group {
        display: grid;
        gap: 0.75rem;
        justify-items: center;
        width: min(140px, 100%);
    }

    .dashboard-chart-value {
        font-size: 1.4rem;
        font-weight: 700;
        letter-spacing: -0.03em;
    }

    .dashboard-chart-bar {
        width: 100%;
        min-height: 18px;
        border-radius: 22px 22px 10px 10px;
        align-self: end;
    }

    .dashboard-chart-bar-active {
        background: var(--accent);
    }

    .dashboard-chart-bar-returned {
        background: var(--success);
    }

    .dashboard-chart-label {
        font-size: 0.9rem;
        color: var(--text-muted);
        text-align: center;
    }

    .dashboard-chart-summary {
        display: grid;
        gap: 0.75rem;
        align-content: start;
    }

    .dashboard-chart-summary-item {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.9rem 1rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        background: var(--surface-soft);
        color: var(--text);
    }

    .dashboard-chart-dot {
        width: 0.85rem;
        height: 0.85rem;
        border-radius: 999px;
        flex: 0 0 auto;
    }

    .dashboard-chart-dot-active {
        background: var(--accent);
    }

    .dashboard-chart-dot-returned {
        background: var(--success);
    }

    @@media (max-width: 900px) {
        .dashboard-chart-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private LendingDashboardStats? _stats;
    private DashboardCounts? _counts;
    private List<DashboardSectionState> _layout = new();
    private List<ModuleTileState> _tiles = new();
    private readonly HashSet<string> _readableModules = new(StringComparer.Ordinal);
    private bool _editLayout;
    private bool _overdueNotified;

    protected override async Task OnInitializedAsync()
    {
        _layout = await LayoutService.GetLayoutAsync();
        _tiles = await TileService.GetLayoutAsync();

        foreach (var module in AppModules.All)
        {
            if (await Permissions.CanReadAsync(module.Key))
            {
                _readableModules.Add(module.Key);
            }
        }

        _counts = await DashboardService.GetCountsAsync();
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Surface overdue lendings once after the dashboard has loaded. When the
        // tab is in the background this reaches the user as a device notification.
        if (firstRender && !_overdueNotified && _stats is { OverdueEntries.Count: > 0 })
        {
            _overdueNotified = true;
            await NotifyOverdueAsync();
        }
    }

    private async Task LoadAsync()
    {
        _stats = await LendingService.GetDashboardStatsAsync();
    }

    // ----- Dashboard customisation -----

    private void StartEditingLayout() => _editLayout = true;

    private void StopEditingLayout() => _editLayout = false;

    private async Task MoveSectionAsync(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _layout.Count)
        {
            return;
        }

        (_layout[index], _layout[target]) = (_layout[target], _layout[index]);
        await LayoutService.SaveLayoutAsync(_layout);
    }

    private async Task ToggleSectionAsync(int index)
    {
        var section = _layout[index];
        _layout[index] = section with { Visible = !section.Visible };
        await LayoutService.SaveLayoutAsync(_layout);
    }

    private async Task MoveTileAsync(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _tiles.Count)
        {
            return;
        }

        (_tiles[index], _tiles[target]) = (_tiles[target], _tiles[index]);
        await TileService.SaveLayoutAsync(_tiles);
    }

    private async Task ToggleTileAsync(int index)
    {
        var tile = _tiles[index];
        _tiles[index] = tile with { Visible = !tile.Visible };
        await TileService.SaveLayoutAsync(_tiles);
    }

    private async Task ResetLayoutAsync()
    {
        await LayoutService.ResetLayoutAsync();
        await TileService.ResetLayoutAsync();
        _layout = await LayoutService.GetLayoutAsync();
        _tiles = await TileService.GetLayoutAsync();
    }

    // ----- Section rendering, dispatched by the user's layout -----

    private RenderFragment SectionFragment(string key) => key switch
    {
        DashboardSections.ModuleTiles => ModuleTiles,
        DashboardSections.Kpis => Kpis,
        DashboardSections.StatusChart => StatusChart,
        DashboardSections.Analytics => AnalyticsSection,
        DashboardSections.Overdue => Overdue,
        DashboardSections.Recent => Recent,
        _ => _ => { }
    };

    private RenderFragment AnalyticsSection => @<AnalyticsBoard />;

    private RenderFragment ModuleTiles => @<text>
        @if (_counts is not null)
        {
            <section class="module-tiles">
                @foreach (var tile in _tiles)
                {
                    if (!tile.Visible || !_readableModules.Contains(tile.Key))
                    {
                        continue;
                    }
                    var module = tile.Module;
                    if (module is null) { continue; }
                    <a class="glass-card module-tile" href="@module.Route">
                        <div class="module-tile-value">@TileValue(tile.Key)</div>
                        <div class="module-tile-label">@TileLabel(tile.Key)</div>
                    </a>
                }
            </section>
        }
    </text>;

    private string TileValue(string key) => key switch
    {
        AppModules.Movies => _counts!.Movies.ToString(),
        AppModules.Tv => _counts!.TvEntries.ToString(),
        AppModules.Games => _counts!.Games.ToString(),
        AppModules.Bmi => _counts!.BmiRecords.ToString(),
        AppModules.Wishlists => _counts!.OpenWishes.ToString(),
        AppModules.Persons => _counts!.Persons.ToString(),
        AppModules.Lending => (_stats?.TotalActive ?? 0).ToString(),
        _ => "—"
    };

    private string TileLabel(string key) => key switch
    {
        AppModules.Movies => "Filme",
        AppModules.Tv => "TV-Einträge",
        AppModules.Games => $"Spiele · {_counts!.OpenMatches} offene Partien",
        AppModules.Bmi => "BMI-Messungen",
        AppModules.Wishlists => $"offene Wünsche · {_counts!.Wishlists} Listen",
        AppModules.Persons => "Personen",
        AppModules.Lending => "Aktive Ausleihen",
        _ => AppModules.Label(key)
    };

    private RenderFragment Kpis => @<text>
        @if (_stats is null)
        {
            <div class="glass-card ui-section">Lade Dashboard...</div>
        }
        else
        {
            <section class="ui-kpi-grid">
                <article class="glass-card ui-kpi-card">
                    <div class="ui-kpi-value">@_stats.TotalActive</div>
                    <div class="ui-kpi-label">Aktive Ausleihen</div>
                </article>
                <article class="glass-card ui-kpi-card">
                    <div class="ui-kpi-value">@_stats.TotalOverdue</div>
                    <div class="ui-kpi-label">Überfällig</div>
                </article>
                <article class="glass-card ui-kpi-card">
                    <div class="ui-kpi-value">@_stats.TotalReturned</div>
                    <div class="ui-kpi-label">Zurückgegeben</div>
                </article>
                <article class="glass-card ui-kpi-card">
                    <div class="ui-kpi-value">@_stats.TotalPersons</div>
                    <div class="ui-kpi-label">Personen</div>
                </article>
            </section>
        }
    </text>;

    private RenderFragment StatusChart => @<text>
        @if (_stats is not null)
        {
            <section class="glass-card ui-section ui-stack dashboard-chart-section">
                <div>
                    <h2 class="ui-section-title">Statusverteilung</h2>
                    <p class="section-subtitle">Vergleich von aktiven und bereits zurückgegebenen Ausleihen.</p>
                </div>

                <div class="dashboard-chart-layout">
                    <div class="dashboard-chart-bars" role="img" aria-label="Diagramm mit aktiven und zurückgegebenen Ausleihen">
                        <div class="dashboard-chart-bar-group">
                            <div class="dashboard-chart-value">@_stats.TotalActive</div>
                            <div class="dashboard-chart-bar dashboard-chart-bar-active" style="height: @GetChartHeight(_stats.TotalActive)%"></div>
                            <div class="dashboard-chart-label">Aktiv</div>
                        </div>
                        <div class="dashboard-chart-bar-group">
                            <div class="dashboard-chart-value">@_stats.TotalReturned</div>
                            <div class="dashboard-chart-bar dashboard-chart-bar-returned" style="height: @GetChartHeight(_stats.TotalReturned)%"></div>
                            <div class="dashboard-chart-label">Zurückgegeben</div>
                        </div>
                    </div>

                    <div class="dashboard-chart-summary">
                        <div class="dashboard-chart-summary-item">
                            <span class="dashboard-chart-dot dashboard-chart-dot-active"></span>
                            <span>@GetShareText(_stats.TotalActive) aktiv</span>
                        </div>
                        <div class="dashboard-chart-summary-item">
                            <span class="dashboard-chart-dot dashboard-chart-dot-returned"></span>
                            <span>@GetShareText(_stats.TotalReturned) zurückgegeben</span>
                        </div>
                    </div>
                </div>
            </section>
        }
    </text>;

    private RenderFragment Overdue => @<text>
        @if (_stats is { OverdueEntries.Count: > 0 })
        {
            <section class="glass-card ui-section ui-stack">
                <div>
                    <h2 class="ui-section-title">Überfällige Ausleihen</h2>
                    <p class="section-subtitle">Direkter Überblick über alle überzogenen Rückgaben.</p>
                </div>

                <div class="ui-table-wrap ui-desktop-table">
                    <table class="table ui-data-table align-middle">
                        <thead>
                            <tr>
                                <th>Gegenstand</th>
                                <th>Entleiher</th>
                                <th>Fällig seit</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _stats.OverdueEntries)
                            {
                                <tr>
                                    <td>@EntryLabel(item)</td>
                                    <td>@item.Borrower?.DisplayName</td>
                                    <td>@FormatDate(item.DueDate)</td>
                                    <td class="table-actions">
                                        @if (CanBeMarkedAsReturned(item))
                                        {
                                            <button class="btn btn-sm btn-success" @onclick="() => MarkAsReturnedAsync(item)">Zurückgegeben</button>
                                        }
                                        <a class="btn btn-sm btn-outline-secondary" href="@($"/lending/edit/{item.Id}")">Bearbeiten</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="ui-mobile-cards">
                    @foreach (var item in _stats.OverdueEntries)
                    {
                        <article class="ui-mobile-card">
                            <div class="ui-mobile-card-head">
                                <div>
                                    <div class="ui-mobile-card-title">@EntryLabel(item)</div>
                                    <div class="ui-mobile-card-subtitle">@ValueOrFallback(item.Borrower?.DisplayName)</div>
                                </div>
                                <LendingStatusBadge Status="@item.Status" />
                            </div>
                            <div class="ui-mobile-meta">
                                <div class="ui-mobile-meta-row"><span>Fällig seit</span><span>@FormatDate(item.DueDate)</span></div>
                            </div>
                            <div class="table-actions">
                                @if (CanBeMarkedAsReturned(item))
                                {
                                    <button class="btn btn-sm btn-success" @onclick="() => MarkAsReturnedAsync(item)">Zurückgegeben</button>
                                }
                                <a class="btn btn-sm btn-outline-secondary" href="@($"/lending/edit/{item.Id}")">Bearbeiten</a>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </text>;

    private RenderFragment Recent => @<text>
        @if (_stats is not null)
        {
            <section class="glass-card ui-section ui-stack">
                <div>
                    <h2 class="ui-section-title">Zuletzt hinzugefügt</h2>
                    <p class="section-subtitle">Neu erfasste Ausleihen mit schnellem Zugriff auf Details und Rückgabe.</p>
                </div>

                @if (_stats.RecentEntries.Count == 0)
                {
                    <p class="empty-hint">Noch keine Ausleihen vorhanden. <a href="/lending/new">Jetzt anlegen</a>.</p>
                }
                else
                {
                    <div class="ui-table-wrap ui-desktop-table">
                        <table class="table ui-data-table align-middle">
                            <thead>
                                <tr>
                                    <th>Gegenstand</th>
                                    <th>Verleiher</th>
                                    <th>Entleiher</th>
                                    <th>Ausleihdatum</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _stats.RecentEntries)
                                {
                                    <tr>
                                        <td>@EntryLabel(item)</td>
                                        <td>@ValueOrFallback(item.Lender?.DisplayName)</td>
                                        <td>@ValueOrFallback(item.Borrower?.DisplayName)</td>
                                        <td>@item.LoanDate.ToString("dd.MM.yyyy")</td>
                                        <td><LendingStatusBadge Status="@item.Status" /></td>
                                        <td class="table-actions">
                                            @if (CanBeMarkedAsReturned(item))
                                            {
                                                <button class="btn btn-sm btn-success" @onclick="() => MarkAsReturnedAsync(item)">Zurückgegeben</button>
                                            }
                                            <a class="btn btn-sm btn-outline-secondary" href="@($"/lending/{item.Id}")">Details</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="ui-mobile-cards">
                        @foreach (var item in _stats.RecentEntries)
                        {
                            <article class="ui-mobile-card">
                                <div class="ui-mobile-card-head">
                                    <div>
                                        <div class="ui-mobile-card-title">@EntryLabel(item)</div>
                                        <div class="ui-mobile-card-subtitle">@ValueOrFallback(item.Lender?.DisplayName) → @ValueOrFallback(item.Borrower?.DisplayName)</div>
                                    </div>
                                    <LendingStatusBadge Status="@item.Status" />
                                </div>
                                <div class="ui-mobile-meta">
                                    <div class="ui-mobile-meta-row"><span>Ausleihdatum</span><span>@item.LoanDate.ToString("dd.MM.yyyy")</span></div>
                                </div>
                                <div class="table-actions">
                                    @if (CanBeMarkedAsReturned(item))
                                    {
                                        <button class="btn btn-sm btn-success" @onclick="() => MarkAsReturnedAsync(item)">Zurückgegeben</button>
                                    }
                                    <a class="btn btn-sm btn-outline-secondary" href="@($"/lending/{item.Id}")">Details</a>
                                </div>
                            </article>
                        }
                    </div>

                    <div class="dashboard-footer">
                        <a href="/lending" class="btn btn-outline-secondary">Alle Ausleihen anzeigen</a>
                    </div>
                }
            </section>
        }
    </text>;

    // ----- Notifications & helpers -----

    private async Task NotifyOverdueAsync()
    {
        if (_stats is null || _stats.OverdueEntries.Count == 0)
        {
            return;
        }

        if (_stats.OverdueEntries.Count == 1)
        {
            var entry = _stats.OverdueEntries[0];
            await Notifications.Notify(AppNotification.LendingDue(
                EntryLabel(entry), entry.DueDate ?? DateTime.Today, entry.Id, overdue: true));
        }
        else
        {
            await Notifications.Notify(new AppNotification
            {
                Title = "Überfällige Ausleihen",
                Body = $"{_stats.OverdueEntries.Count} Ausleihen sind überfällig.",
                Severity = NotificationSeverity.Error,
                Kind = NotificationKind.LendingDue,
                NavigateUrl = "/lending",
                DurationMs = 8000
            });
        }
    }

    private static string EntryLabel(LendingEntry item)
    {
        if (!string.IsNullOrWhiteSpace(item.Title))
        {
            return item.Title!;
        }

        var firstItem = item.Items
            .OrderBy(x => x.SortOrder)
            .Select(x => x.Name)
            .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));

        return firstItem ?? "Ausleihe";
    }

    private static bool CanBeMarkedAsReturned(LendingEntry item)
        => !item.ReturnedAt.HasValue
           && item.Status is not LendingEntryStatus.Returned
           && item.Status is not LendingEntryStatus.GivenAway
           && item.Status is not LendingEntryStatus.Lost;

    private async Task MarkAsReturnedAsync(LendingEntry item)
    {
        var updatedEntry = new LendingEntry
        {
            Id = item.Id,
            Title = item.Title,
            Description = item.Description,
            LenderId = item.LenderId,
            BorrowerId = item.BorrowerId,
            LoanDate = item.LoanDate,
            DueDate = item.DueDate,
            ReturnedAt = DateTime.Today,
            Notes = item.Notes,
            Status = item.Status
        };

        var updated = await LendingService.UpdateAsync(updatedEntry);
        if (updated is null)
        {
            ToastService.Error("Der Eintrag konnte nicht aktualisiert werden.");
            return;
        }

        ToastService.Success("Eintrag als zurückgegeben markiert.");
        await Notifications.Notify(AppNotification.LendingReturned(EntryLabel(item), item.Id));
        await LoadAsync();
    }

    private int GetChartHeight(int value)
    {
        if (_stats is null)
        {
            return 0;
        }

        var max = Math.Max(_stats.TotalActive, _stats.TotalReturned);
        if (max <= 0)
        {
            return 18;
        }

        return Math.Max(18, (int)Math.Round((double)value / max * 100));
    }

    private string GetShareText(int value)
    {
        if (_stats is null)
        {
            return "0 %";
        }

        var total = _stats.TotalActive + _stats.TotalReturned;
        if (total <= 0)
        {
            return "0 %";
        }

        var percentage = (double)value / total * 100;
        return $"{Math.Round(percentage, 1):0.#} %";
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("dd.MM.yyyy") : "-";

    private static string ValueOrFallback(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
