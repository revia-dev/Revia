@* Global notification host. Mount once (in the main layout). It subscribes to
   NotificationService and routes every notification to either the in-app channel
   (when the page is focused) or the device/OS channel (when it is not).

   Reusable: raise notifications from anywhere by injecting NotificationService
   and calling Notify(...). No per-page wiring required. *@

@using Revia.Services
@implements IAsyncDisposable
@inject NotificationService Notifications
@inject IJSRuntime JS
@inject NavigationManager Navigation

@* Permission prompt — shown only when notifications are supported but not yet
   decided, so the user can opt in to device notifications. *@
@if (_showPermissionPrompt)
{
    <div class="notif-permission" role="dialog" aria-label="Benachrichtigungen aktivieren">
        <span class="notif-permission-icon"><Icon Name="bell" Size="18" /></span>
        <div class="notif-permission-copy">
            <strong>Benachrichtigungen aktivieren?</strong>
            <span>Erhalte Hinweise auch, wenn das Fenster im Hintergrund ist.</span>
        </div>
        <div class="notif-permission-actions">
            <button type="button" class="notif-btn notif-btn-primary" @onclick="RequestPermissionAsync">Aktivieren</button>
            <button type="button" class="notif-btn" @onclick="DismissPermissionPrompt" aria-label="Schließen">
                <Icon Name="x-lg" Size="14" />
            </button>
        </div>
    </div>
}

@* In-app toast stack. *@
<div class="notif-stack" aria-live="polite" aria-atomic="false">
    @foreach (var item in _active)
    {
        <div class="notif-toast notif-@SeverityClass(item.Notification.Severity) @(item.Visible ? "is-visible" : "") @(item.Notification.NavigateUrl is not null ? "is-clickable" : "")"
             role="alert"
             @key="item.Notification.Id"
             @onclick="() => OnToastClick(item)">
            <span class="notif-toast-icon"><Icon Name="@SeverityIcon(item.Notification.Severity)" Size="18" /></span>
            <div class="notif-toast-body">
                <div class="notif-toast-title">@item.Notification.Title</div>
                @if (!string.IsNullOrWhiteSpace(item.Notification.Body))
                {
                    <div class="notif-toast-text">@item.Notification.Body</div>
                }
            </div>
            <button type="button" class="notif-toast-close" aria-label="Schließen" @onclick:stopPropagation="true" @onclick="() => Dismiss(item)">
                <Icon Name="x-lg" Size="13" />
            </button>
        </div>
    }
</div>

@code {
    private const string ModulePath = "/js/notifications.js";

    private IJSObjectReference? _module;
    private DotNetObjectReference<NotificationCenter>? _selfRef;
    private readonly List<ActiveNotification> _active = new();
    private bool _showPermissionPrompt;
    private string _permission = "default";

    protected override void OnInitialized()
        => Notifications.OnNotify += HandleNotifyAsync;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _selfRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("registerClickHandler", _selfRef);

            _permission = await _module.InvokeAsync<string>("permissionStatus");
            // Offer the opt-in only when the API exists and the user hasn't decided.
            if (_permission == "default")
            {
                _showPermissionPrompt = true;
                StateHasChanged();
            }
        }
        catch
        {
            // JS unavailable (e.g. prerender) — in-app channel still works.
        }
    }

    private async Task HandleNotifyAsync(AppNotification notification)
    {
        var pageFocused = true;

        if (_module is not null)
        {
            try
            {
                pageFocused = await _module.InvokeAsync<bool>("isPageFocused");
                // Re-read permission at send time: the user may have granted it
                // (e.g. via our opt-in prompt) after the component first rendered,
                // so a value cached at first render would be stale.
                _permission = await _module.InvokeAsync<string>("permissionStatus");
            }
            catch
            {
                pageFocused = true;
            }
        }

        var channel = NotificationRouter.Route(
            notification,
            pageFocused,
            permissionGranted: _permission == "granted");

        // Try the device channel when routing says so; fall back to in-app if the
        // OS notification could not actually be shown.
        var deviceShown = false;
        if (channel == NotificationChannel.Device && _module is not null)
        {
            try
            {
                deviceShown = await _module.InvokeAsync<bool>(
                    "showDevice",
                    notification.Title,
                    notification.Body ?? string.Empty,
                    notification.IconUrl,
                    notification.NavigateUrl);
            }
            catch
            {
                deviceShown = false;
            }
        }

        if (!deviceShown)
        {
            await ShowInAppAsync(notification);
        }
    }

    private async Task ShowInAppAsync(AppNotification notification)
    {
        var item = new ActiveNotification(notification);
        _active.Add(item);
        await InvokeAsync(StateHasChanged);

        // Slide-in on next frame.
        await Task.Delay(40);
        item.Visible = true;
        await InvokeAsync(StateHasChanged);

        var duration = Math.Clamp(notification.DurationMs, 1500, 20000);
        await Task.Delay(duration);

        // It may already have been dismissed manually.
        if (_active.Contains(item))
        {
            await DismissInternal(item);
        }
    }

    private Task OnToastClick(ActiveNotification item)
    {
        if (item.Notification.NavigateUrl is { } url)
        {
            Navigation.NavigateTo(url);
        }
        return DismissInternal(item);
    }

    private Task Dismiss(ActiveNotification item) => DismissInternal(item);

    private async Task DismissInternal(ActiveNotification item)
    {
        item.Visible = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(300);
        _active.Remove(item);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Invoked from JS when an OS notification is clicked.</summary>
    [JSInvokable]
    public Task OnNotificationClicked(string navigateUrl)
    {
        if (!string.IsNullOrWhiteSpace(navigateUrl))
        {
            Navigation.NavigateTo(navigateUrl);
        }
        return InvokeAsync(StateHasChanged);
    }

    private async Task RequestPermissionAsync()
    {
        _showPermissionPrompt = false;
        if (_module is null)
        {
            return;
        }

        try
        {
            _permission = await _module.InvokeAsync<string>("requestPermission");
        }
        catch
        {
            // ignore
        }
        StateHasChanged();
    }

    private void DismissPermissionPrompt() => _showPermissionPrompt = false;

    private static string SeverityClass(NotificationSeverity s) => s switch
    {
        NotificationSeverity.Success => "success",
        NotificationSeverity.Warning => "warning",
        NotificationSeverity.Error   => "error",
        _                            => "info"
    };

    private static string SeverityIcon(NotificationSeverity s) => s switch
    {
        NotificationSeverity.Success => "check-circle",
        NotificationSeverity.Warning => "exclamation-triangle",
        NotificationSeverity.Error   => "x-circle",
        _                            => "info-circle"
    };

    public async ValueTask DisposeAsync()
    {
        Notifications.OnNotify -= HandleNotifyAsync;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeClickHandler");
                await _module.DisposeAsync();
            }
            catch
            {
                // circuit already gone
            }
        }

        _selfRef?.Dispose();
    }

    private sealed class ActiveNotification(AppNotification notification)
    {
        public AppNotification Notification { get; } = notification;
        public bool Visible { get; set; }
    }
}
