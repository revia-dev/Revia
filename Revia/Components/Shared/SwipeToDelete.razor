@* Reusable swipe-to-delete wrapper.

   Wrap any record (a card, a table row container, a list item) in this component.
   On touch devices the user swipes the content to the left to reveal a red delete
   button; tapping it raises OnDelete. On desktop the same red delete button is
   reachable by hovering/focusing the row (and by keyboard), so the feature works
   everywhere without a mouse-drag gesture.

   The actual deletion + Undo is the caller's responsibility (see DeferredDelete);
   this component only manages the reveal gesture and surfaces the delete intent. *@

@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="swipe-row @(_open ? "swipe-open" : "")" @ref="_element">
    <button type="button"
            class="swipe-delete"
            aria-label="@DeleteLabel"
            title="@DeleteLabel"
            @onclick="HandleDeleteAsync">
        <Icon Name="trash" Size="20" />
    </button>

    <div class="swipe-surface" data-swipe-surface>
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Raised when the user taps the revealed delete button.</summary>
    [Parameter] public EventCallback OnDelete { get; set; }

    /// <summary>Accessible label / tooltip for the delete button.</summary>
    [Parameter] public string DeleteLabel { get; set; } = "Löschen";

    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SwipeToDelete>? _selfRef;
    private int _handle;
    private bool _open;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            // Importing an ES module is cached by the browser, so each instance's
            // import resolves quickly after the first; this keeps the reference
            // bound to the current circuit (a shared static would dangle once the
            // first circuit that created it is disposed).
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/swipe.js");
            _selfRef = DotNetObjectReference.Create(this);
            _handle = await _module.InvokeAsync<int>("register", _element, _selfRef);
        }
        catch
        {
            // JS unavailable (prerender) — the delete button is still usable via
            // hover/focus, so the feature degrades gracefully.
        }
    }

    [JSInvokable]
    public Task OnSwipeStateChanged(bool open)
    {
        _open = open;
        return InvokeAsync(StateHasChanged);
    }

    private async Task HandleDeleteAsync()
    {
        // Close the row before the caller mutates the list, so a recycled row
        // doesn't stay visually "open".
        await CloseAsync();
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync();
        }
    }

    private async Task CloseAsync()
    {
        _open = false;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("close", _handle); } catch { /* ignore */ }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                if (_handle != 0)
                {
                    await _module.InvokeVoidAsync("unregister", _handle);
                }
                await _module.DisposeAsync();
            }
            catch
            {
                // circuit already gone
            }
        }

        _selfRef?.Dispose();
    }
}
