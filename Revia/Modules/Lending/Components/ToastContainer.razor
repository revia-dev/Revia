@using Revia.Modules.Lending.Services
@inject ToastService ToastService
@implements IDisposable

@foreach (var toast in _toasts)
{
    <div class="toast-item toast-@toast.Type.ToString().ToLower() @(toast.Visible ? "toast-visible" : "")"
         role="alert" aria-live="polite">
        <span class="toast-icon">
            @if (toast.Type == ToastType.Success) { <span>✓</span> }
            else if (toast.Type == ToastType.Error) { <span>✕</span> }
            else { <span>ℹ</span> }
        </span>
        <span class="toast-text">@toast.Text</span>
        @if (!string.IsNullOrEmpty(toast.ActionLabel))
        {
            <button type="button" class="toast-action" @onclick="() => InvokeActionAsync(toast)">
                @toast.ActionLabel
            </button>
        }
    </div>
}

@code {
    private readonly List<ActiveToast> _toasts = new();

    protected override void OnInitialized()
        => ToastService.OnShow += HandleShow;

    private void HandleShow(ToastMessage msg)
    {
        var toast = new ActiveToast(msg);
        _toasts.Add(toast);
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await Task.Delay(50);
            toast.Visible = true;
            StateHasChanged();

            await Task.Delay(msg.DurationMs);

            // The action (e.g. Undo) may have already dismissed this toast.
            if (toast.Dismissed)
            {
                return;
            }

            await DismissAsync(toast);
        });
    }

    private async Task InvokeActionAsync(ActiveToast toast)
    {
        if (toast.Dismissed)
        {
            return;
        }

        toast.Dismissed = true;
        if (toast.Message.OnAction is not null)
        {
            await toast.Message.OnAction.Invoke();
        }

        await DismissAsync(toast);
    }

    private async Task DismissAsync(ActiveToast toast)
    {
        toast.Dismissed = true;
        toast.Visible = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(400);
        _toasts.Remove(toast);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
        => ToastService.OnShow -= HandleShow;

    private class ActiveToast(ToastMessage message)
    {
        public ToastMessage Message { get; } = message;
        public string Text => Message.Text;
        public ToastType Type => Message.Type;
        public string? ActionLabel => Message.ActionLabel;
        public bool Visible { get; set; }
        public bool Dismissed { get; set; }
    }
}
