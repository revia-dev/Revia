@using Microsoft.AspNetCore.Components.Forms
@using PrivateLibrary.Modules.Lending.Models

<EditForm Model="@Model" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="glass-card form-shell">
        <div class="form-grid">
            <div class="field">
                <label>Vorname</label>
                <InputText class="form-control" @bind-Value="Model.FirstName" />
                <ValidationMessage For="@(() => Model.FirstName)" />
            </div>

            <div class="field">
                <label>Nachname</label>
                <InputText class="form-control" @bind-Value="Model.LastName" />
                <ValidationMessage For="@(() => Model.LastName)" />
            </div>

            <div class="field">
                <label>Spitzname</label>
                <InputText class="form-control" @bind-Value="Model.Nickname" />
                <ValidationMessage For="@(() => Model.Nickname)" />
            </div>

            <div class="field">
                <label>E-Mail</label>
                <InputText class="form-control" @bind-Value="Model.Email" />
                <ValidationMessage For="@(() => Model.Email)" />
            </div>

            <div class="field">
                <label>Telefon</label>
                <InputText class="form-control" @bind-Value="Model.Phone" />
                <ValidationMessage For="@(() => Model.Phone)" />
            </div>

            <div class="field">
                <label>Straße</label>
                <InputText class="form-control" @bind-Value="Model.Street" />
                <ValidationMessage For="@(() => Model.Street)" />
            </div>

            <div class="field">
                <label>Hausnummer</label>
                <InputText class="form-control" @bind-Value="Model.HouseNumber" />
                <ValidationMessage For="@(() => Model.HouseNumber)" />
            </div>

            <div class="field">
                <label>PLZ</label>
                <InputText class="form-control" @bind-Value="Model.PostalCode" />
                <ValidationMessage For="@(() => Model.PostalCode)" />
            </div>

            <div class="field">
                <label>Ort</label>
                <InputText class="form-control" @bind-Value="Model.City" />
                <ValidationMessage For="@(() => Model.City)" />
            </div>

            <div class="field field-wide">
                <label>Notizen</label>
                <InputTextArea class="form-control" rows="4" @bind-Value="Model.Notes" />
                <ValidationMessage For="@(() => Model.Notes)" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-modern">@SubmitText</button>
            @if (CancelUrl is not null)
            {
                <a class="btn btn-secondary btn-modern" href="@CancelUrl">Abbrechen</a>
            }
        </div>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public PersonEditModel Model { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public string SubmitText { get; set; } = "Speichern";

    [Parameter]
    public string? CancelUrl { get; set; }

    private Task HandleValidSubmit() => OnValidSubmit.InvokeAsync();
}
