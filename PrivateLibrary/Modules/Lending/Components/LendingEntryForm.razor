@using Microsoft.AspNetCore.Components.Forms
@using PrivateLibrary.Modules.Lending.Models

<EditForm Model="@Model" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary class="validation-summary-errors" />

    <div class="glass-card form-shell">
        <div class="form-grid">
            <div class="field">
                <label for="title">Titel</label>
                <InputText id="title" class="form-control visible-input" @bind-Value="Model.Title" />
                <ValidationMessage For="@(() => Model.Title)" />
            </div>

            <div class="field field-wide">
                <label for="new-item-name">Gegenstände</label>

                <div class="item-add-row">
                    <InputText id="new-item-name" class="form-control visible-input" @bind-Value="Model.NewItemName" />
                    <button type="button" class="btn btn-secondary btn-modern" @onclick="AddItemToGrid">Hinzufügen</button>
                </div>

                @if (Model.ItemNames.Count > 0)
                {
                    <div class="item-grid">
                        @for (var i = 0; i < Model.ItemNames.Count; i++)
                        {
                            var itemName = Model.ItemNames[i];
                            <div class="item-grid-row">
                                <div class="item-grid-name">@itemName</div>
                                <button type="button"
                                        class="btn btn-outline-secondary btn-modern item-remove-btn"
                                        @onclick="() => RemoveItem(i)">
                                    Entfernen
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-hint">Noch keine Gegenstände hinzugefügt.</div>
                }

                <ValidationMessage For="@(() => Model.ItemNames)" />
            </div>

            <div class="field">
                <label for="category">Kategorie</label>
                <InputText id="category" class="form-control visible-input" @bind-Value="Model.Category" />
                <ValidationMessage For="@(() => Model.Category)" />
            </div>

            <div class="field">
                <label for="lender">Verleiher</label>
                <InputSelect id="lender" class="form-select visible-input" @bind-Value="Model.LenderId">
                    <option value="">Bitte wählen</option>
                    @foreach (var person in People)
                    {
                        <option value="@person.Id">@person.DisplayName</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => Model.LenderId)" />
            </div>

            <div class="field">
                <label for="borrower">Entleiher</label>
                <InputSelect id="borrower" class="form-select visible-input" @bind-Value="Model.BorrowerId">
                    <option value="">Bitte wählen</option>
                    @foreach (var person in People)
                    {
                        <option value="@person.Id">@person.DisplayName</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => Model.BorrowerId)" />
            </div>

            <div class="field">
                <label for="loan-date">Ausleihdatum</label>
                <InputDate id="loan-date" class="form-control visible-input" @bind-Value="Model.LoanDate" />
                <ValidationMessage For="@(() => Model.LoanDate)" />
            </div>

            <div class="field">
                <label for="due-date">Geplantes Rückgabedatum</label>
                <InputDate id="due-date" class="form-control visible-input" @bind-Value="Model.DueDate" />
                <ValidationMessage For="@(() => Model.DueDate)" />
            </div>

            <div class="field">
                <label for="returned-at">Tatsächliche Rückgabe</label>
                <InputDate id="returned-at" class="form-control visible-input" @bind-Value="Model.ReturnedAt" />
                <ValidationMessage For="@(() => Model.ReturnedAt)" />
            </div>

            <div class="field">
                <label for="status">Status</label>
                <InputSelect id="status" class="form-select visible-input" @bind-Value="Model.Status">
                    <option value="@LendingEntryStatus.Active">Aktiv</option>
                    <option value="@LendingEntryStatus.Overdue">Überfällig</option>
                    <option value="@LendingEntryStatus.Returned">Zurückgegeben</option>
                    <option value="@LendingEntryStatus.Lost">Verloren</option>
                    <option value="@LendingEntryStatus.GivenAway">Verschenkt</option>
                </InputSelect>
            </div>

            <div class="field field-wide">
                <label for="description">Beschreibung</label>
                <InputTextArea id="description" class="form-control visible-input" rows="4" @bind-Value="Model.Description" />
                <ValidationMessage For="@(() => Model.Description)" />
            </div>

            <div class="field field-wide">
                <label for="notes">Notizen</label>
                <InputTextArea id="notes" class="form-control visible-input" rows="4" @bind-Value="Model.Notes" />
                <ValidationMessage For="@(() => Model.Notes)" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-modern">@SubmitText</button>
            @if (!string.IsNullOrWhiteSpace(CancelUrl))
            {
                <a class="btn btn-secondary btn-modern" href="@CancelUrl">Abbrechen</a>
            }
        </div>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public LendingEntryEditModel Model { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<Person> People { get; set; } = Array.Empty<Person>();

    [Parameter, EditorRequired]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public string SubmitText { get; set; } = "Speichern";

    [Parameter]
    public string? CancelUrl { get; set; }

    private Task HandleValidSubmit() => OnValidSubmit.InvokeAsync();

    private void AddItemToGrid()
    {
        var normalizedName = (Model.NewItemName ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(normalizedName))
        {
            return;
        }

        if (!Model.ItemNames.Any(x => string.Equals(x, normalizedName, StringComparison.OrdinalIgnoreCase)))
        {
            Model.ItemNames.Add(normalizedName);
        }

        Model.NewItemName = string.Empty;
    }

    private void RemoveItem(int index)
    {
        if (index < 0 || index >= Model.ItemNames.Count)
        {
            return;
        }

        Model.ItemNames.RemoveAt(index);
    }
}
