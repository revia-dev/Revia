@using Microsoft.AspNetCore.Components.Forms
@using PrivateLibrary.Modules.Lending.Models

<EditForm Model="@Model" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="glass-card form-shell">
        <div class="form-grid">
            <div class="field">
                <label>Titel</label>
                <InputText class="form-control" @bind-Value="Model.Title" />
                <ValidationMessage For="@(() => Model.Title)" />
            </div>

            <div class="field field-wide">
                <label>Gegenstand</label>
                <InputText class="form-control" @bind-Value="Model.ItemName" />
                <ValidationMessage For="@(() => Model.ItemName)" />
            </div>

            <div class="field">
                <label>Kategorie</label>
                <InputText class="form-control" @bind-Value="Model.Category" />
                <ValidationMessage For="@(() => Model.Category)" />
            </div>

            <div class="field">
                <label>Verleiher</label>
                <InputSelect class="form-select" @bind-Value="Model.LenderId">
                    <option value="">Bitte wählen</option>
                    @foreach (var person in People)
                    {
                        <option value="@person.Id">@person.DisplayName</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => Model.LenderId)" />
            </div>

            <div class="field">
                <label>Entleiher</label>
                <InputSelect class="form-select" @bind-Value="Model.BorrowerId">
                    <option value="">Bitte wählen</option>
                    @foreach (var person in People)
                    {
                        <option value="@person.Id">@person.DisplayName</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => Model.BorrowerId)" />
            </div>

            <div class="field">
                <label>Ausleihdatum</label>
                <InputDate class="form-control" @bind-Value="Model.LoanDate" />
                <ValidationMessage For="@(() => Model.LoanDate)" />
            </div>

            <div class="field">
                <label>Geplantes Rückgabedatum</label>
                <InputDate class="form-control" @bind-Value="Model.DueDate" />
                <ValidationMessage For="@(() => Model.DueDate)" />
            </div>

            <div class="field">
                <label>Tatsächliche Rückgabe</label>
                <InputDate class="form-control" @bind-Value="Model.ReturnedAt" />
                <ValidationMessage For="@(() => Model.ReturnedAt)" />
            </div>

            <div class="field">
                <label>Status</label>
                <InputSelect class="form-select" @bind-Value="Model.Status">
                    <option value="@LendingEntryStatus.Active">Aktiv</option>
                    <option value="@LendingEntryStatus.Overdue">Überfällig</option>
                    <option value="@LendingEntryStatus.Returned">Zurückgegeben</option>
                    <option value="@LendingEntryStatus.Lost">Verloren</option>
                    <option value="@LendingEntryStatus.GivenAway">Verschenkt</option>
                </InputSelect>
            </div>

            <div class="field field-wide">
                <label>Beschreibung</label>
                <InputTextArea class="form-control" rows="4" @bind-Value="Model.Description" />
                <ValidationMessage For="@(() => Model.Description)" />
            </div>

            <div class="field field-wide">
                <label>Notizen</label>
                <InputTextArea class="form-control" rows="4" @bind-Value="Model.Notes" />
                <ValidationMessage For="@(() => Model.Notes)" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-modern">@SubmitText</button>
            @if (CancelUrl is not null)
            {
                <a class="btn btn-secondary btn-modern" href="@CancelUrl">Abbrechen</a>
            }
        </div>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public LendingEntryEditModel Model { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<Person> People { get; set; } = Array.Empty<Person>();

    [Parameter, EditorRequired]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public string SubmitText { get; set; } = "Speichern";

    [Parameter]
    public string? CancelUrl { get; set; }

    private Task HandleValidSubmit() => OnValidSubmit.InvokeAsync();
}
