@page "/lending/persons/new"
@page "/lending/persons/edit/{Id:int}"
@using PrivateLibrary.Modules.Lending.Models
@inject PrivateLibrary.Modules.Lending.Services.IPersonService PersonService
@inject NavigationManager Navigation

<PageTitle>@PageTitleText</PageTitle>

<div class="page-shell">
    <div class="glass-card page-header">
        <div>
            <h1>@PageTitleText</h1>
            <p>Person erfassen oder bearbeiten.</p>
        </div>
    </div>

    @if (_model is null)
    {
        <div class="glass-card loading-card">Lade Formular...</div>
    }
    else
    {
        <PersonForm Model="_model" SubmitText="@SubmitText" CancelUrl="/lending/persons" OnValidSubmit="SaveAsync" />
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private PersonEditModel? _model;

    private string PageTitleText => Id.HasValue ? "Person bearbeiten" : "Neue Person";
    private string SubmitText => Id.HasValue ? "Änderungen speichern" : "Person anlegen";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            var person = await PersonService.GetByIdAsync(Id.Value);
            if (person is null)
            {
                Navigation.NavigateTo("/lending/persons");
                return;
            }

            _model = new PersonEditModel
            {
                Id = person.Id,
                FirstName = person.FirstName,
                LastName = person.LastName,
                Nickname = person.Nickname,
                Email = person.Email,
                Phone = person.Phone,
                Street = person.Street,
                HouseNumber = person.HouseNumber,
                PostalCode = person.PostalCode,
                City = person.City,
                Notes = person.Notes
            };
        }
        else
        {
            _model = new PersonEditModel();
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        var entity = new Person
        {
            Id = _model.Id,
            FirstName = _model.FirstName,
            LastName = _model.LastName,
            Nickname = _model.Nickname,
            Email = _model.Email,
            Phone = _model.Phone,
            Street = _model.Street,
            HouseNumber = _model.HouseNumber,
            PostalCode = _model.PostalCode,
            City = _model.City,
            Notes = _model.Notes
        };

        if (entity.Id == 0)
        {
            var created = await PersonService.CreateAsync(entity);
            Navigation.NavigateTo("/lending/persons");
            return;
        }

        var updated = await PersonService.UpdateAsync(entity);
        if (updated is null)
        {
            Navigation.NavigateTo("/lending/persons");
            return;
        }

        Navigation.NavigateTo("/lending/persons");
    }
}
