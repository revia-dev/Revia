@inherits LayoutComponentBase
@using PrivateLibrary.Modules.Lending.Components

<div class="app-shell">
    <div class="app-layout">
        <aside class="app-sidebar">
            <NavMenu />
        </aside>

        <main class="app-main">
            <header class="app-topbar">
                <div class="app-topbar-copy">
                    <div class="app-topbar-eyebrow">Private Library</div>
                    <h1 class="app-topbar-title">Filmarchiv und Ausleihen</h1>
                </div>

                <AuthorizeView>
                    <Authorized>
                        <div class="app-topbar-user">
                            <span class="app-topbar-user-label">Angemeldet</span>
                            <span class="app-topbar-user-name">@context.User.Identity?.Name</span>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="app-topbar-user">
                            <span class="app-topbar-user-label">Nicht angemeldet</span>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </header>

            <section class="app-content-shell">
                <div class="app-content">
                    @Body
                </div>
            </section>
        </main>
    </div>
</div>

<ToastContainer />
