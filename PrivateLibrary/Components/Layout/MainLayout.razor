@inherits LayoutComponentBase
@using PrivateLibrary.Modules.Lending.Components
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Http
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

@code {
    private string? _antiforgeryToken;

    protected override void OnInitialized()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is not null)
        {
            _antiforgeryToken = Antiforgery.GetAndStoreTokens(httpContext).RequestToken;
        }
    }
}

<div class="app-shell">
    <div class="app-layout">
        <aside class="app-sidebar">
            <NavMenu />
        </aside>

        <main class="app-main">
            <header class="app-topbar">
                <AuthorizeView>
                    <Authorized>
                        <div class="app-topbar-actions">
                            <div class="app-topbar-user">
                                <span class="app-topbar-user-label">Angemeldet</span>
                                <span class="app-topbar-user-name">@context.User.Identity?.Name</span>
                            </div>

                            <form method="post" action="/account/logout" class="app-auth-form">
                                <input type="hidden" name="__RequestVerificationToken" value="@_antiforgeryToken" />
                                <input type="hidden" name="returnUrl" value="/" />
                                <button type="submit" class="app-auth-button app-auth-button-secondary">Logout</button>
                            </form>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="app-topbar-actions">
                            <a href="/account/login" class="app-auth-button">Anmelden</a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </header>

            <section class="app-content-shell">
                <div class="app-content">
                    @Body
                </div>
            </section>
        </main>
    </div>
</div>

<ToastContainer />
