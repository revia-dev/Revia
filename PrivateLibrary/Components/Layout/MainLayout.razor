@inherits LayoutComponentBase
@using PrivateLibrary.Modules.Lending.Components
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Http
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

@code {
    private string? _antiforgeryToken;

    protected override void OnInitialized()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is not null)
        {
            _antiforgeryToken = Antiforgery.GetAndStoreTokens(httpContext).RequestToken;
        }
    }
}

<div class="app-shell">
    <main class="app-main">
        <header class="app-topbar">
            <a class="app-brand" href="" title="Private Library">
                <img src="/images/icon-192.png" alt="Private Library" />
            </a>

            <NavMenu />

            <div class="app-topbar-spacer"></div>

            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/account/logout" class="app-auth-form">
                        <input type="hidden" name="__RequestVerificationToken" value="@_antiforgeryToken" />
                        <input type="hidden" name="returnUrl" value="/" />
                        <button type="submit" class="app-auth-button app-auth-button-secondary">Logout</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="/account/login" class="app-auth-button">Anmelden</a>
                </NotAuthorized>
            </AuthorizeView>
        </header>

        <section class="app-content-shell">
            <div class="app-content">
                @Body
            </div>
        </section>
    </main>

    <AuthorizeView>
        <Authorized>
            <div class="app-userbadge" title="Angemeldet als @context.User.Identity?.Name">
                <span class="app-userbadge-label">Angemeldet als</span>
                <span class="app-userbadge-name">@context.User.Identity?.Name</span>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

<ToastContainer />
