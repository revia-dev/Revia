@* User-configurable analytics widgets for the dashboard. Users build a widget by
   naming it and choosing a metric + options, can reorder, edit and delete them,
   and each widget renders a small ranked bar list of its result. *@

@using PrivateLibrary.Data
@using PrivateLibrary.Services
@inject AnalyticsService Analytics
@inject PrivateLibrary.Modules.Lending.Services.ToastService ToastService

<section class="glass-card ui-section ui-stack analytics-board">
    <div class="analytics-head">
        <div>
            <h2 class="ui-section-title">Analysen</h2>
            <p class="section-subtitle">Stelle dir eigene Auswertungen zusammen.</p>
        </div>
        <button class="btn btn-primary btn-sm" @onclick="StartCreate">
            <Icon Name="plus-lg" /> <span>Neue Analyse</span>
        </button>
    </div>

    @if (_editing is not null)
    {
        <div class="analytics-editor glass-card">
            <div class="form-grid">
                <div class="field field-wide">
                    <label for="an-name">Name</label>
                    <input id="an-name" class="form-control" maxlength="80" @bind="_editing.Name" placeholder="z. B. Meist ausgeliehene Dinge" />
                </div>

                <div class="field field-wide">
                    <label for="an-metric">Analyse</label>
                    <select id="an-metric" class="form-select" @bind="_selectedMetric">
                        @foreach (var m in AnalyticsMetrics.All)
                        {
                            <option value="@m.Key">@m.Label</option>
                        }
                    </select>
                    @if (CurrentMetric is not null)
                    {
                        <small class="text-muted">@CurrentMetric.Description</small>
                    }
                </div>

                @if (CurrentMetric is not null)
                {
                    foreach (var opt in CurrentMetric.Options)
                    {
                        <div class="field">
                            <label>@opt.Label</label>
                            @if (opt.Type == AnalyticsOptionType.Number)
                            {
                                <input class="form-control" type="number" min="1" max="50"
                                       value="@GetOption(opt)" @onchange="e => SetOption(opt.Key, e.Value?.ToString())" />
                            }
                            else if (opt.Type == AnalyticsOptionType.Choice && opt.Choices is not null)
                            {
                                <select class="form-select" value="@GetOption(opt)" @onchange="e => SetOption(opt.Key, e.Value?.ToString())">
                                    @foreach (var (val, label) in opt.Choices)
                                    {
                                        <option value="@val">@label</option>
                                    }
                                </select>
                            }
                        </div>
                    }
                }
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveAsync">Speichern</button>
                <button class="btn btn-outline-secondary" @onclick="CancelEdit">Abbrechen</button>
            </div>
        </div>
    }

    @if (_widgets.Count == 0 && _editing is null)
    {
        <p class="empty-hint">Noch keine Analysen. Lege deine erste Auswertung an.</p>
    }
    else
    {
        <div class="analytics-grid">
            @for (var i = 0; i < _widgets.Count; i++)
            {
                var index = i;
                var widget = _widgets[index];
                <article class="analytics-card glass-card">
                    <header class="analytics-card-head">
                        <div class="analytics-card-title">@widget.Name</div>
                        <div class="analytics-card-actions">
                            <IconButton IconName="arrow-up" AriaLabel="Nach oben" Disabled="index == 0"
                                        OnClick="() => MoveAsync(widget.Id, -1)" />
                            <IconButton IconName="arrow-down" AriaLabel="Nach unten" Disabled="index == _widgets.Count - 1"
                                        OnClick="() => MoveAsync(widget.Id, 1)" />
                            <IconButton IconName="pencil" AriaLabel="Bearbeiten" OnClick="() => StartEdit(widget)" />
                            <IconButton IconName="trash" AriaLabel="Löschen" CssClass="btn-icon-danger"
                                        OnClick="() => DeleteAsync(widget.Id)" />
                        </div>
                    </header>

                    @if (_results.TryGetValue(widget.Id, out var result))
                    {
                        if (result.Rows.Count == 0)
                        {
                            <div class="analytics-empty">@(result.Empty ?? "Keine Daten.")</div>
                        }
                        else
                        {
                            var max = result.Rows.Max(r => r.Value);
                            <ul class="analytics-rows">
                                @foreach (var row in result.Rows)
                                {
                                    <li class="analytics-row">
                                        <span class="analytics-row-label" title="@row.Label">@row.Label</span>
                                        <span class="analytics-bar-wrap">
                                            <span class="analytics-bar" style="width:@BarWidth(row.Value, max)%"></span>
                                        </span>
                                        <span class="analytics-row-value">@FormatValue(row)</span>
                                    </li>
                                }
                            </ul>
                        }
                    }
                    else
                    {
                        <div class="analytics-empty">Lade…</div>
                    }
                </article>
            }
        </div>
    }
</section>

@code {
    private List<AnalyticsWidget> _widgets = new();
    private readonly Dictionary<int, AnalyticsResult> _results = new();

    private AnalyticsWidget? _editing;
    private string _selectedMetric = AnalyticsMetrics.All[0].Key;
    private Dictionary<string, string> _options = new();

    private AnalyticsMetric? CurrentMetric => AnalyticsMetrics.Find(_selectedMetric);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _widgets = await Analytics.GetWidgetsAsync();
        _results.Clear();
        foreach (var widget in _widgets)
        {
            try
            {
                _results[widget.Id] = await Analytics.EvaluateAsync(widget);
            }
            catch
            {
                _results[widget.Id] = new AnalyticsResult(Array.Empty<AnalyticsRow>(), "Auswertung fehlgeschlagen.");
            }
        }
    }

    private void StartCreate()
    {
        _editing = new AnalyticsWidget { Name = "", Metric = AnalyticsMetrics.All[0].Key };
        _selectedMetric = _editing.Metric;
        _options = new();
    }

    private void StartEdit(AnalyticsWidget widget)
    {
        _editing = new AnalyticsWidget { Id = widget.Id, Name = widget.Name, Metric = widget.Metric, OptionsJson = widget.OptionsJson };
        _selectedMetric = widget.Metric;
        _options = AnalyticsService.ParseOptions(widget.OptionsJson);
    }

    private void CancelEdit() => _editing = null;

    private string? GetOption(AnalyticsOption opt)
        => _options.TryGetValue(opt.Key, out var v) ? v : opt.Default;

    private void SetOption(string key, string? value)
        => _options[key] = value ?? string.Empty;

    private async Task SaveAsync()
    {
        if (_editing is null)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            ToastService.Error("Bitte einen Namen vergeben.");
            return;
        }

        _editing.Metric = _selectedMetric;
        // Drop options that don't belong to the chosen metric.
        var allowed = CurrentMetric?.Options.Select(o => o.Key).ToHashSet() ?? new();
        var clean = _options.Where(kv => allowed.Contains(kv.Key)).ToDictionary(kv => kv.Key, kv => kv.Value);

        try
        {
            await Analytics.SaveAsync(_editing, clean);
            _editing = null;
            await LoadAsync();
            ToastService.Success("Analyse gespeichert.");
        }
        catch (Exception ex)
        {
            ToastService.Error(ex.Message);
        }
    }

    private async Task DeleteAsync(int id)
    {
        await Analytics.DeleteAsync(id);
        await LoadAsync();
    }

    private async Task MoveAsync(int id, int delta)
    {
        await Analytics.MoveAsync(id, delta);
        await LoadAsync();
    }

    private static int BarWidth(double value, double max)
        => max <= 0 ? 0 : Math.Max(4, (int)Math.Round(value / max * 100));

    private static string FormatValue(AnalyticsRow row)
    {
        var num = row.Value == Math.Floor(row.Value) ? row.Value.ToString("0") : row.Value.ToString("0.##");
        return string.IsNullOrEmpty(row.ValueSuffix) ? num : $"{num} {row.ValueSuffix}";
    }
}
