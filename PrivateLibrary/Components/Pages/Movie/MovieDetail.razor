@using PrivateLibrary.Models
@inject PrivateLibrary.Services.PosterResolverService PosterResolver

@if (Film is not null)
{
    <div class="movie-detail-backdrop" @onclick="HandleClose"></div>

    <section class="movie-detail-panel" role="dialog" aria-modal="true" aria-labelledby="movie-detail-title">
        <header class="movie-detail-header">
            <div class="movie-detail-heading">
                <p class="movie-detail-eyebrow">Movie Details</p>
                <h3 id="movie-detail-title">@DisplayTitle</h3>

                @if (!string.IsNullOrWhiteSpace(Film.Jahr))
                {
                    <p class="movie-detail-subtitle">Erscheinungsjahr: @Film.Jahr</p>
                }
            </div>

            <IconButton IconName="x-lg" AriaLabel="Detailansicht schließen" OnClick="HandleClose" />
        </header>

        @if (CanWrite)
        {
            <div class="movie-detail-actions">
                <button type="button" class="btn btn-outline-secondary" @onclick="HandleEdit">Bearbeiten</button>
                <button type="button" class="btn btn-outline-danger" @onclick="HandleDelete">Löschen</button>
            </div>
        }

        <div class="movie-detail-body">
            <div class="movie-detail-poster-col">
                <div class="movie-detail-poster-shell">
                    <img src="@PosterUrl" alt="@DisplayTitle" class="movie-detail-poster" />
                </div>
            </div>

            <div class="movie-detail-info-col">
                <div class="movie-detail-info-card">
                    @if (!string.IsNullOrWhiteSpace(Film.Fsk))
                    {
                        <p><strong>FSK:</strong> @Film.Fsk</p>
                    }

                    @if (Film.Runtime is int rt)
                    {
                        <p><strong>Länge:</strong> @rt Min</p>
                    }

                    @if (Film.Anbieter?.Any() == true)
                    {
                        <p><strong>Anbieter:</strong> @string.Join(", ", Film.Anbieter)</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(Film.Kategorie))
                    {
                        <p><strong>Kategorie:</strong> @Film.Kategorie</p>
                    }

                    @if (Film.Tags?.Any() == true)
                    {
                        <div class="movie-detail-taglist">
                            @foreach (var tag in Film.Tags)
                            {
                                <span>@tag</span>
                            }
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Film.Handlung))
                {
                    <div class="movie-detail-info-card">
                        <h4>Handlung</h4>
                        <p>@Film.Handlung</p>
                    </div>
                }
            </div>
        </div>

        @if (_seriesGroups.Count > 0)
        {
            <section class="movie-detail-related">
                <h4>Filmreihen</h4>

                @if (_seriesGroups.Count > 1)
                {
                    <div class="series-tabs">
                        @foreach (var group in _seriesGroups)
                        {
                            <button type="button"
                                    class="series-tab @(group.Key == _activeSeries ? "is-active" : "")"
                                    @onclick="() => _activeSeries = group.Key">
                                @group.Key (@group.Value.Count)
                            </button>
                        }
                    </div>
                }

                <div class="movie-detail-related-grid">
                    @foreach (var related in ActiveSeriesFilms)
                    {
                        <button type="button"
                                class="movie-detail-related-card @(related.Id == Film.Id ? "is-active" : "")"
                                @onclick="() => SelectRelated(related)">
                            <span class="related-poster-shell">
                                <img src="@PosterResolver.ResolvePosterUrl(related)" alt="@related.Titel" loading="lazy" />
                            </span>
                            <span class="related-title">@(related.Titel ?? "Unbekannt")</span>
                        </button>
                    }
                </div>
            </section>
        }
    </section>
}

@code {
    [Parameter] public Film? Film { get; set; }
    [Parameter] public List<Film> AllFilms { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Film> OnFilmSelected { get; set; }
    [Parameter] public EventCallback<Film> OnEdit { get; set; }
    [Parameter] public EventCallback<Film> OnDelete { get; set; }
    [Parameter] public bool CanWrite { get; set; } = true;

    // series key -> films sharing it (each key is one tab)
    private Dictionary<string, List<Film>> _seriesGroups = new();
    private string? _activeSeries;

    private string DisplayTitle => Film?.Titel ?? "Unbekannt";

    private string PosterUrl
        => Film is null
            ? "/images/placeholder.png"
            : (PosterResolver.ResolvePosterUrl(Film) ?? "/images/placeholder.png");

    private IReadOnlyList<Film> ActiveSeriesFilms
        => _activeSeries is not null && _seriesGroups.TryGetValue(_activeSeries, out var films)
            ? films
            : Array.Empty<Film>();

    protected override void OnParametersSet()
    {
        _seriesGroups = new Dictionary<string, List<Film>>();

        if (Film is null) return;

        foreach (var key in SeriesKeys(Film))
        {
            var films = AllFilms
                .Where(m => SeriesKeys(m).Contains(key))
                .OrderBy(m => m.Jahr, StringComparer.OrdinalIgnoreCase)
                .ThenBy(m => m.Titel, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (films.Count >= 2)
            {
                _seriesGroups[key] = films;
            }
        }

        if (_activeSeries is null || !_seriesGroups.ContainsKey(_activeSeries))
        {
            _activeSeries = _seriesGroups.Keys.FirstOrDefault();
        }
    }

    // A film may belong to several series; "#a#b#c" encodes multiple levels, each a key.
    private static IEnumerable<string> SeriesKeys(Film film)
        => (film.Tags ?? Enumerable.Empty<string>())
            .Where(t => t.Contains('#'))
            .SelectMany(t => t.Split('#', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            .Select(s => s.Trim())
            .Where(s => s.Length > 0)
            .Select(s => s.ToLowerInvariant())
            .Distinct();

    private Task HandleClose()
        => OnClose.HasDelegate ? OnClose.InvokeAsync() : Task.CompletedTask;

    private Task SelectRelated(Film film)
        => OnFilmSelected.HasDelegate ? OnFilmSelected.InvokeAsync(film) : Task.CompletedTask;

    private Task HandleEdit()
        => Film is not null && OnEdit.HasDelegate ? OnEdit.InvokeAsync(Film) : Task.CompletedTask;

    private Task HandleDelete()
        => Film is not null && OnDelete.HasDelegate ? OnDelete.InvokeAsync(Film) : Task.CompletedTask;
}
