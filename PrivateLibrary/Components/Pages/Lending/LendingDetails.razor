@page "/lending/{Id:int}"
@using PrivateLibrary.Modules.Lending.Models
@inject PrivateLibrary.Modules.Lending.Services.ILendingService LendingService
@inject PrivateLibrary.Modules.Lending.Services.ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>Ausleih-Details</PageTitle>

<div class="page-shell">
    @if (_item is null)
    {
        <div class="glass-card empty-card">Eintrag nicht gefunden.</div>
    }
    else
    {
        <div class="glass-card detail-card">
            <div class="detail-top">
                <div>
                    <h1>@_item.ItemName</h1>
                    <p>@_item.Title</p>
                </div>
                <LendingStatusBadge Status="@_item.Status" />
            </div>

            <dl class="detail-grid">
                <dt>Beschreibung</dt><dd>@ValueOrFallback(_item.Description)</dd>
                <dt>Kategorie</dt><dd>@ValueOrFallback(_item.Category)</dd>
                <dt>Verleiher</dt><dd>@ValueOrFallback(_item.Lender?.DisplayName)</dd>
                <dt>Entleiher</dt><dd>@ValueOrFallback(_item.Borrower?.DisplayName)</dd>
                <dt>Ausleihdatum</dt><dd>@_item.LoanDate.ToString("dd.MM.yyyy")</dd>
                <dt>Geplant zurück</dt><dd>@(_item.DueDate.HasValue ? _item.DueDate.Value.ToString("dd.MM.yyyy") : "-")</dd>
                <dt>Zurückgegeben</dt><dd>@(_item.ReturnedAt.HasValue ? _item.ReturnedAt.Value.ToString("dd.MM.yyyy") : "-")</dd>
                <dt>Notizen</dt><dd>@ValueOrFallback(_item.Notes)</dd>
                <dt>Erstellt</dt><dd>@_item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
                <dt>Geändert</dt><dd>@_item.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
            </dl>

            <div class="actions">
                @if (CanBeMarkedAsReturned)
                {
                    <button type="button" class="btn btn-success btn-modern" @onclick="MarkAsReturnedAsync">
                        Als zurückgegeben markieren
                    </button>
                }
                <a class="btn btn-primary btn-modern" href="@($"/lending/edit/{_item.Id}")">Bearbeiten</a>
                <a class="btn btn-secondary btn-modern" href="/lending">Zurück zur Liste</a>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private LendingEntry? _item;

    private bool CanBeMarkedAsReturned => _item is not null
        && !_item.ReturnedAt.HasValue
        && _item.Status is not LendingEntryStatus.Returned
        && _item.Status is not LendingEntryStatus.GivenAway
        && _item.Status is not LendingEntryStatus.Lost;

    protected override async Task OnParametersSetAsync()
    {
        _item = await LendingService.GetByIdAsync(Id);
    }

    private async Task MarkAsReturnedAsync()
    {
        if (_item is null)
        {
            return;
        }

        var updatedEntry = new LendingEntry
        {
            Id = _item.Id,
            Title = _item.Title,
            Description = _item.Description,
            ItemName = _item.ItemName,
            Category = _item.Category,
            LenderId = _item.LenderId,
            BorrowerId = _item.BorrowerId,
            LoanDate = _item.LoanDate,
            DueDate = _item.DueDate,
            ReturnedAt = DateTime.Today,
            Notes = _item.Notes,
            Status = _item.Status
        };

        var updated = await LendingService.UpdateAsync(updatedEntry);
        if (updated is null)
        {
            ToastService.Error("Der Eintrag konnte nicht aktualisiert werden.");
            return;
        }

        ToastService.Success("Eintrag als zurückgegeben markiert.");
        _item = await LendingService.GetByIdAsync(Id);
    }

    private static string ValueOrFallback(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
