@page "/lending"
@using Microsoft.AspNetCore.Components
@using PrivateLibrary.Modules.Lending.Models
@inject PrivateLibrary.Modules.Lending.Services.ILendingService LendingService
@inject NavigationManager Navigation

<PageTitle>Ausleihen</PageTitle>

<div class="page-shell">
    <div class="page-header glass-card">
        <div>
            <h1>Ausleihen</h1>
            <p>Verliehene und geliehene Gegenstände verwalten.</p>
        </div>
        <div class="header-actions">
            <a class="btn btn-primary btn-modern" href="/lending/new">Neu anlegen</a>
            <a class="btn btn-outline-secondary btn-modern" href="/lending/persons">Personen</a>
        </div>
    </div>

    <div class="glass-card filter-bar">
        <label>Status filtern</label>
        <select class="form-select" @onchange="OnStatusChanged">
            <option value="">Alle</option>
            <option value="@LendingEntryStatus.Active">Aktiv</option>
            <option value="@LendingEntryStatus.Overdue">Überfällig</option>
            <option value="@LendingEntryStatus.Returned">Zurückgegeben</option>
            <option value="@LendingEntryStatus.Lost">Verloren</option>
            <option value="@LendingEntryStatus.GivenAway">Verschenkt</option>
        </select>
    </div>

    @if (_items is null)
    {
        <div class="glass-card loading-card">Lade Einträge...</div>
    }
    else if (_items.Count == 0)
    {
        <div class="glass-card empty-card">
            <p>Keine Ausleihen vorhanden.</p>
            <a class="btn btn-primary btn-modern" href="/lending/new">Erste Ausleihe anlegen</a>
        </div>
    }
    else
    {
        <div class="glass-card table-card">
            <table class="table lending-table align-middle">
                <thead>
                    <tr>
                        <th>Gegenstand</th>
                        <th>Verleiher</th>
                        <th>Entleiher</th>
                        <th>Ausleihdatum</th>
                        <th>Fällig am</th>
                        <th>Rückgabe</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr class="table-row-clickable @(item.Status == LendingEntryStatus.Overdue ? "row-overdue" : "")" @onclick="() => OnRowClick(item.Id)">
                            <td>
                                <div class="item-title">@item.ItemName</div>
                                @if (!string.IsNullOrWhiteSpace(item.Category))
                                {
                                    <div class="text-muted small">@item.Category</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Title))
                                {
                                    <div class="text-muted small">@item.Title</div>
                                }
                            </td>
                            <td>@item.Lender?.DisplayName</td>
                            <td>@item.Borrower?.DisplayName</td>
                            <td>@item.LoanDate.ToString("dd.MM.yyyy")</td>
                            <td>@(item.DueDate.HasValue ? item.DueDate.Value.ToString("dd.MM.yyyy") : "-")</td>
                            <td>@(item.ReturnedAt.HasValue ? item.ReturnedAt.Value.ToString("dd.MM.yyyy") : "-")</td>
                            <td><LendingStatusBadge Status="@item.Status" /></td>
                            <td class="actions" @onclick:stopPropagation="true">
                                <a class="btn btn-sm btn-outline-secondary" href="@($"/lending/edit/{item.Id}")">Bearbeiten</a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(item.Id)">Löschen</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .table-row-clickable {
        cursor: pointer;
        transition: background-color 0.15s ease;
    }
    .table-row-clickable:hover {
        background-color: rgba(255, 255, 255, 0.05);
    }
    .row-overdue td:not(.actions) {
        color: #e05c5c;
    }
</style>

@code {
    private IReadOnlyList<LendingEntry>? _items;
    private LendingEntryStatus? StatusFilter;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _items = await LendingService.GetAllAsync(StatusFilter);
    }

    private async Task OnStatusChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        StatusFilter = Enum.TryParse<LendingEntryStatus>(value, out var parsed) ? parsed : null;
        await LoadAsync();
    }

    private void OnRowClick(int id)
    {
        Navigation.NavigateTo("/lending/" + id);
    }

    private void ConfirmDelete(int id)
    {
        Navigation.NavigateTo("/lending/delete/" + id);
    }
}
