@page "/lending/new"
@page "/lending/edit/{Id:int}"
@using PrivateLibrary.Modules.Lending.Models
@using Microsoft.AspNetCore.Components.Forms
@inject PrivateLibrary.Modules.Lending.Services.ILendingService LendingService
@inject PrivateLibrary.Modules.Lending.Services.IPersonService PersonService
@inject PrivateLibrary.Modules.Lending.Services.ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>@(_id.HasValue ? "Ausleih-Eintrag bearbeiten" : "Neuer Ausleih-Eintrag")</PageTitle>

<div class="page-shell">
    <div class="glass-card page-header">
        <div>
            <h1>@(_id.HasValue ? "Ausleih-Eintrag bearbeiten" : "Neuer Ausleih-Eintrag")</h1>
            <p>Eintrag erfassen oder bearbeiten.</p>
        </div>
        <a class="btn btn-outline-secondary btn-modern" href="/lending/persons/new">Neue Person</a>
    </div>

    @if (_model is null)
    {
        <div class="glass-card loading-card">Lade Formular...</div>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="glass-card form-shell">
                <div class="form-grid">
                    <div class="field">
                        <label>Titel</label>
                        <InputText class="form-control" @bind-Value="_model.Title" />
                    </div>
                    <div class="field field-wide">
                        <label>Gegenstand *</label>
                        <InputText class="form-control" @bind-Value="_model.ItemName" />
                        <ValidationMessage For="@(() => _model.ItemName)" />
                    </div>
                    <div class="field">
                        <label>Kategorie</label>
                        <InputText class="form-control" @bind-Value="_model.Category" />
                    </div>
                    <div class="field">
                        <label>Verleiher *</label>
                        <InputSelect class="form-select" @bind-Value="_model.LenderId">
                            <option value="">Bitte wählen</option>
                            @foreach (var p in _people)
                            {
                                <option value="@p.Id">@p.DisplayName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _model.LenderId)" />
                    </div>
                    <div class="field">
                        <label>Entleiher *</label>
                        <InputSelect class="form-select" @bind-Value="_model.BorrowerId">
                            <option value="">Bitte wählen</option>
                            @foreach (var p in _people)
                            {
                                <option value="@p.Id">@p.DisplayName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _model.BorrowerId)" />
                    </div>
                    <div class="field">
                        <label>Ausleihdatum *</label>
                        <InputDate class="form-control" @bind-Value="_model.LoanDate" />
                        <ValidationMessage For="@(() => _model.LoanDate)" />
                    </div>
                    <div class="field">
                        <label>Geplantes Rückgabedatum</label>
                        <InputDate class="form-control" @bind-Value="_model.DueDate" />
                        <ValidationMessage For="@(() => _model.DueDate)" />
                    </div>
                    <div class="field">
                        <label>Tatsächliche Rückgabe</label>
                        <InputDate class="form-control" @bind-Value="_model.ReturnedAt" />
                    </div>
                    <div class="field">
                        <label>Status</label>
                        <InputSelect class="form-select" @bind-Value="_model.Status">
                            <option value="@LendingEntryStatus.Active">Aktiv</option>
                            <option value="@LendingEntryStatus.Overdue">Überfällig</option>
                            <option value="@LendingEntryStatus.Returned">Zurückgegeben</option>
                            <option value="@LendingEntryStatus.Lost">Verloren</option>
                            <option value="@LendingEntryStatus.GivenAway">Verschenkt</option>
                        </InputSelect>
                    </div>
                    <div class="field field-wide">
                        <label>Beschreibung</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="_model.Description" />
                    </div>
                    <div class="field field-wide">
                        <label>Notizen</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="_model.Notes" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-modern">
                        @(_id.HasValue ? "Änderungen speichern" : "Eintrag anlegen")
                    </button>
                    <a class="btn btn-secondary btn-modern" href="/lending">Abbrechen</a>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private int? _id;
    private LendingEntryEditModel? _model;
    private IReadOnlyList<Person> _people = Array.Empty<Person>();

    protected override async Task OnParametersSetAsync()
    {
        _id = Id;
        _people = await PersonService.GetLookupAsync();

        if (_id.HasValue)
        {
            var item = await LendingService.GetByIdAsync(_id.Value);
            if (item is null)
            {
                Navigation.NavigateTo("/lending");
                return;
            }
            _model = new LendingEntryEditModel
            {
                Id = item.Id,
                Title = item.Title,
                Description = item.Description,
                ItemName = item.ItemName,
                Category = item.Category,
                LenderId = item.LenderId,
                BorrowerId = item.BorrowerId,
                LoanDate = item.LoanDate,
                DueDate = item.DueDate,
                ReturnedAt = item.ReturnedAt,
                Status = item.Status,
                Notes = item.Notes
            };
        }
        else
        {
            _model ??= new LendingEntryEditModel
            {
                LoanDate = DateTime.Today,
                Status = LendingEntryStatus.Active
            };
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null) return;

        var entity = new LendingEntry
        {
            Id = _model.Id,
            Title = _model.Title,
            Description = _model.Description,
            ItemName = _model.ItemName,
            Category = _model.Category,
            LenderId = _model.LenderId ?? 0,
            BorrowerId = _model.BorrowerId ?? 0,
            LoanDate = _model.LoanDate ?? DateTime.Today,
            DueDate = _model.DueDate,
            ReturnedAt = _model.ReturnedAt,
            Notes = _model.Notes,
            Status = _model.Status
        };

        if (entity.Id == 0)
        {
            var created = await LendingService.CreateAsync(entity);
            ToastService.Success("Eintrag erfolgreich angelegt.");
            Navigation.NavigateTo("/lending/" + created.Id);
        }
        else
        {
            await LendingService.UpdateAsync(entity);
            ToastService.Success("Änderungen gespeichert.");
            Navigation.NavigateTo("/lending/" + entity.Id);
        }
    }
}
