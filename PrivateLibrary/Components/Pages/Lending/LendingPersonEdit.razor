@page "/lending/persons/new"
@page "/lending/persons/edit/{Id}"
@using PrivateLibrary.Data
@using PrivateLibrary.Modules.Lending.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject PrivateLibrary.Modules.Lending.Services.IPersonService PersonService
@inject PrivateLibrary.Modules.Lending.Services.ToastService ToastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>@(_id is not null ? "Person bearbeiten" : "Neue Person")</PageTitle>

<div class="page-shell">
    <div class="glass-card page-header">
        <div>
            <h1>@(_id is not null ? "Person bearbeiten" : "Neue Person anlegen")</h1>
            <p>Personen verwalten und optional Rollen zuweisen.</p>
        </div>
    </div>

    @if (_model is null)
    {
        <div class="glass-card loading-card">Lade Formular...</div>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="person-edit-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary-errors" />

            <div class="glass-card form-shell">
                <div class="form-grid">
                    <div class="field field-wide">
                        <label class="checkbox-field">
                            <InputCheckbox @bind-Value="_model.IsLoginless" disabled="@(!_model.IsNew)" />
                            <span>Person ohne Login (kein Benutzername/Passwort, kann sich nicht anmelden)</span>
                        </label>
                        @if (!_model.IsNew && _model.IsLoginless)
                        {
                            <small class="text-muted">Diese Person ist ein reiner Datensatz ohne Anmeldung.</small>
                        }
                    </div>

                    <div class="field">
                        <label>Vorname *</label>
                        <InputText class="form-control" @bind-Value="_model.FirstName" />
                        <ValidationMessage For="@(() => _model.FirstName)" />
                    </div>
                    <div class="field">
                        <label>Nachname *</label>
                        <InputText class="form-control" @bind-Value="_model.LastName" />
                        <ValidationMessage For="@(() => _model.LastName)" />
                    </div>
                    <div class="field">
                        <label>Spitzname</label>
                        <InputText class="form-control" @bind-Value="_model.Nickname" />
                    </div>
                    @if (!_model.IsLoginless)
                    {
                        <div class="field">
                            <label>Benutzername *</label>
                            <InputText class="form-control" @bind-Value="_model.UserName" autocomplete="off" />
                            <ValidationMessage For="@(() => _model.UserName)" />
                        </div>
                        <div class="field">
                            <label>E-Mail *</label>
                            <InputText class="form-control" @bind-Value="_model.Email" />
                            <ValidationMessage For="@(() => _model.Email)" />
                        </div>
                    }
                    <div class="field">
                        <label>Telefon</label>
                        <InputText class="form-control" @bind-Value="_model.Phone" />
                    </div>
                    <div class="field">
                        <label>Straße</label>
                        <InputText class="form-control" @bind-Value="_model.Street" />
                    </div>
                    <div class="field">
                        <label>Hausnummer</label>
                        <InputText class="form-control" @bind-Value="_model.HouseNumber" />
                    </div>
                    <div class="field">
                        <label>PLZ</label>
                        <InputText class="form-control" @bind-Value="_model.PostalCode" />
                    </div>
                    <div class="field">
                        <label>Ort</label>
                        <InputText class="form-control" @bind-Value="_model.City" />
                    </div>
                    <div class="field field-wide">
                        <label>Notizen</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="_model.Notes" />
                    </div>

                    @if (!_model.IsLoginless)
                    {
                        <div class="field">
                            <label>@(_model.IsNew ? "Passwort *" : "Neues Passwort")</label>
                            <InputText type="password" class="form-control" @bind-Value="_model.Password" autocomplete="new-password" />
                            <ValidationMessage For="@(() => _model.Password)" />
                            @if (!_model.IsNew)
                            {
                                <small class="text-muted">Leer lassen, um das Passwort nicht zu ändern.</small>
                            }
                        </div>
                        <div class="field">
                            <label>Passwort bestätigen</label>
                            <InputText type="password" class="form-control" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" />
                            <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                        </div>
                    }

                    @if (_model.CanManageRoles)
                    {
                        <div class="field field-wide">
                            <label>Rolle</label>
                            <InputSelect class="form-select" @bind-Value="_model.SelectedRole">
                                @foreach (var role in _model.AvailableRoles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _model.SelectedRole)" />
                            <small class="text-muted">Neue Benutzer erhalten standardmäßig die Rolle User.</small>
                        </div>
                    }
                </div>

                @if (!_model.IsNew)
                {
                    <div class="profile-photo-section">
                        <h2 class="ui-section-title">Profilbild</h2>
                        <div class="profile-photo-row">
                            <div class="profile-photo-preview">
                                @if (_hasPhoto)
                                {
                                    <img src="@($"/persons/photo/{_id}?v={_photoVersion}")" alt="Profilbild" />
                                }
                                else
                                {
                                    <div class="profile-photo-placeholder">Kein Bild</div>
                                }
                            </div>
                            <div class="profile-photo-controls">
                                <InputFile OnChange="OnProfilePhotoSelectedAsync" accept="image/*" class="form-control" />
                                @if (_uploadingPhoto)
                                {
                                    <div class="photo-empty"><span class="spinner spinner-sm"></span> Bild wird hochgeladen ...</div>
                                }
                                @if (_hasPhoto)
                                {
                                    <button type="button" class="btn btn-secondary btn-modern" @onclick="RemoveProfilePhotoAsync">Bild entfernen</button>
                                }
                                @if (!string.IsNullOrWhiteSpace(_photoError))
                                {
                                    <div class="login-error">@_photoError</div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (!_model.IsNew)
                {
                    <div class="profile-photo-section">
                        <h2 class="ui-section-title">QR-Code</h2>
                        <div class="profile-photo-row">
                            <img class="person-qr" src="@($"/persons/qr/{_id}")" alt="QR-Code" />
                            <div class="profile-photo-controls">
                                <p class="text-muted">
                                    Scannt ein anderer Haushalt diesen QR-Code, wird diese Person dort
                                    übernommen und beide Haushalte werden verknüpft (gemeinsame Sicht auf Ausleihen).
                                </p>
                            </div>
                        </div>
                    </div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-modern">
                        @(_id is not null ? "Änderungen speichern" : "Person anlegen")
                    </button>
                    <a class="btn btn-secondary btn-modern" href="/lending/persons">Abbrechen</a>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }

    private string? _id;
    private PersonEditModel? _model;
    private bool _canManageRoles;

    private bool _hasPhoto;
    private int _photoVersion = 1;
    private bool _uploadingPhoto;
    private string? _photoError;

    private const long MaxPhotoBytes = 15 * 1024 * 1024;

    protected override async Task OnParametersSetAsync()
    {
        _id = Id;
        _canManageRoles = await CurrentUserIsAdminAsync();
        var availableRoles = _canManageRoles
            ? await PersonService.GetAvailableRolesAsync()
            : Array.Empty<string>();

        if (_id is not null)
        {
            var user = await PersonService.GetByIdAsync(_id);
            if (user is null)
            {
                Navigation.NavigateTo("/lending/persons");
                return;
            }

            _model = new PersonEditModel
            {
                Id = user.Id,
                FirstName = user.FirstName,
                LastName = user.LastName,
                Nickname = user.Nickname,
                Email = user.Email ?? string.Empty,
                UserName = user.UserName ?? string.Empty,
                Phone = user.Phone,
                Street = user.Street,
                HouseNumber = user.HouseNumber,
                PostalCode = user.PostalCode,
                City = user.City,
                Notes = user.Notes,
                IsSystemUser = user.IsSystemUser,
                IsLoginless = user.IsLoginless,
                CanManageRoles = _canManageRoles,
                SelectedRole = IdentitySeeder.UserRoleName,
                AvailableRoles = availableRoles
            };

            _hasPhoto = !string.IsNullOrWhiteSpace(user.ProfilePhotoFileName);
        }
        else
        {
            _model = new PersonEditModel
            {
                CanManageRoles = _canManageRoles,
                SelectedRole = IdentitySeeder.UserRoleName,
                AvailableRoles = availableRoles
            };
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null)
            return;

        var entity = new ApplicationUser
        {
            FirstName = _model.FirstName,
            LastName = _model.LastName,
            Nickname = _model.Nickname,
            Email = _model.Email,
            UserName = _model.UserName,
            Phone = _model.Phone,
            Street = _model.Street,
            HouseNumber = _model.HouseNumber,
            PostalCode = _model.PostalCode,
            City = _model.City,
            Notes = _model.Notes,
            IsSystemUser = _model.IsSystemUser,
            IsLoginless = _model.IsLoginless
        };
        // For existing users, set the Id so UpdateAsync/SetPasswordAsync can look them up.
        // For new users, leave the constructor-generated GUID intact — setting Id=""
        // causes EF to conflict when creating a second user in the same circuit scope.
        if (!_model.IsNew)
            entity.Id = _model.Id!;

        try
        {
            if (_model.IsNew)
            {
                if (_model.IsLoginless)
                {
                    await PersonService.CreateLoginlessAsync(entity);
                    ToastService.Success("Person (ohne Login) erfolgreich angelegt.");
                }
                else
                {
                    var roleName = _canManageRoles ? _model.SelectedRole : IdentitySeeder.UserRoleName;
                    await PersonService.CreateAsync(entity, _model.Password!, roleName);
                    ToastService.Success("Person erfolgreich angelegt.");
                }
            }
            else
            {
                var roleName = _canManageRoles ? _model.SelectedRole : null;
                await PersonService.UpdateAsync(entity, roleName);

                if (!string.IsNullOrWhiteSpace(_model.Password))
                {
                    var pwResult = await PersonService.SetPasswordAsync(entity.Id, _model.Password);
                    if (!pwResult.Succeeded)
                    {
                        ToastService.Error(pwResult.ErrorMessage ?? "Passwort konnte nicht gesetzt werden.");
                        return;
                    }
                }

                ToastService.Success("Änderungen gespeichert.");
            }

            Navigation.NavigateTo("/lending/persons");
        }
        catch (Exception ex)
        {
            ToastService.Error(ex.Message);
        }
    }

    private async Task<bool> CurrentUserIsAdminAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.IsInRole(IdentitySeeder.AdminRoleName);
    }

    private async Task OnProfilePhotoSelectedAsync(InputFileChangeEventArgs e)
    {
        if (_id is null)
            return;

        _photoError = null;
        var file = e.File;

        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            _photoError = "Es werden nur Bilddateien unterstützt.";
            return;
        }

        _uploadingPhoto = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxPhotoBytes);
            var result = await PersonService.SetProfilePhotoAsync(_id, stream, file.ContentType, file.Name);
            if (!result.Succeeded)
            {
                _photoError = result.ErrorMessage ?? "Bild konnte nicht gespeichert werden.";
                return;
            }

            _hasPhoto = true;
            _photoVersion++;
            ToastService.Success("Profilbild gespeichert.");
        }
        catch (Exception ex)
        {
            _photoError = ex.Message;
        }
        finally
        {
            _uploadingPhoto = false;
        }
    }

    private async Task RemoveProfilePhotoAsync()
    {
        if (_id is null)
            return;

        var result = await PersonService.RemoveProfilePhotoAsync(_id);
        if (!result.Succeeded)
        {
            _photoError = result.ErrorMessage ?? "Bild konnte nicht entfernt werden.";
            return;
        }

        _hasPhoto = false;
        _photoVersion++;
        ToastService.Success("Profilbild entfernt.");
    }
}
