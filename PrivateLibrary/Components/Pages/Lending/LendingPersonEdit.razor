@page "/lending/persons/new"
@page "/lending/persons/edit/{Id:int}"
@using PrivateLibrary.Modules.Lending.Models
@using Microsoft.AspNetCore.Components.Forms
@inject PrivateLibrary.Modules.Lending.Services.IPersonService PersonService
@inject PrivateLibrary.Modules.Lending.Services.ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>@(_id.HasValue ? "Person bearbeiten" : "Neue Person")</PageTitle>

<div class="page-shell">
    <div class="glass-card page-header">
        <div>
            <h1>@(_id.HasValue ? "Person bearbeiten" : "Neue Person")</h1>
            <p>Person erfassen oder bearbeiten.</p>
        </div>
    </div>

    @if (_model is null)
    {
        <div class="glass-card loading-card">Lade Formular...</div>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="glass-card form-shell">
                <div class="form-grid">
                    <div class="field">
                        <label>Vorname *</label>
                        <InputText class="form-control" @bind-Value="_model.FirstName" />
                        <ValidationMessage For="@(() => _model.FirstName)" />
                    </div>
                    <div class="field">
                        <label>Nachname *</label>
                        <InputText class="form-control" @bind-Value="_model.LastName" />
                        <ValidationMessage For="@(() => _model.LastName)" />
                    </div>
                    <div class="field">
                        <label>Spitzname</label>
                        <InputText class="form-control" @bind-Value="_model.Nickname" />
                    </div>
                    <div class="field">
                        <label>E-Mail</label>
                        <InputText class="form-control" @bind-Value="_model.Email" />
                        <ValidationMessage For="@(() => _model.Email)" />
                    </div>
                    <div class="field">
                        <label>Telefon</label>
                        <InputText class="form-control" @bind-Value="_model.Phone" />
                    </div>
                    <div class="field">
                        <label>Straße</label>
                        <InputText class="form-control" @bind-Value="_model.Street" />
                    </div>
                    <div class="field">
                        <label>Hausnummer</label>
                        <InputText class="form-control" @bind-Value="_model.HouseNumber" />
                    </div>
                    <div class="field">
                        <label>PLZ</label>
                        <InputText class="form-control" @bind-Value="_model.PostalCode" />
                    </div>
                    <div class="field">
                        <label>Ort</label>
                        <InputText class="form-control" @bind-Value="_model.City" />
                    </div>
                    <div class="field field-wide">
                        <label>Notizen</label>
                        <InputTextArea class="form-control" rows="4" @bind-Value="_model.Notes" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-modern">
                        @(_id.HasValue ? "Änderungen speichern" : "Person anlegen")
                    </button>
                    <a class="btn btn-secondary btn-modern" href="/lending/persons">Abbrechen</a>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private int? _id;
    private PersonEditModel? _model;

    protected override async Task OnParametersSetAsync()
    {
        _id = Id;

        if (_id.HasValue)
        {
            var person = await PersonService.GetByIdAsync(_id.Value);
            if (person is null)
            {
                Navigation.NavigateTo("/lending/persons");
                return;
            }
            _model = new PersonEditModel
            {
                Id = person.Id,
                FirstName = person.FirstName,
                LastName = person.LastName,
                Nickname = person.Nickname,
                Email = person.Email,
                Phone = person.Phone,
                Street = person.Street,
                HouseNumber = person.HouseNumber,
                PostalCode = person.PostalCode,
                City = person.City,
                Notes = person.Notes
            };
        }
        else
        {
            _model ??= new PersonEditModel();
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null) return;

        var entity = new Person
        {
            Id = _model.Id,
            FirstName = _model.FirstName,
            LastName = _model.LastName,
            Nickname = _model.Nickname,
            Email = _model.Email,
            Phone = _model.Phone,
            Street = _model.Street,
            HouseNumber = _model.HouseNumber,
            PostalCode = _model.PostalCode,
            City = _model.City,
            Notes = _model.Notes
        };

        if (entity.Id == 0)
            await PersonService.CreateAsync(entity);
        else
            await PersonService.UpdateAsync(entity);

        ToastService.Success(_id.HasValue ? "Änderungen gespeichert." : "Person erfolgreich angelegt.");
        Navigation.NavigateTo("/lending/persons");
    }
}
