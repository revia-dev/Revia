@page "/games/{Id:int}"
@using PrivateLibrary.Data
@using PrivateLibrary.Modules.Games
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize]
@inject GameService GameService
@inject PrivateLibrary.Modules.Lending.Services.ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>@(_game?.Name ?? "Spiel")</PageTitle>

<div class="page-shell">
    @if (_game is null)
    {
        <div class="glass-card">Lade ...</div>
    }
    else
    {
        <div class="glass-card page-header">
            <div>
                <h1>@_game.Name</h1>
                <p>@string.Join(", ", _game.Types.Select(t => GameLabels.Type(t.Type)))@(string.IsNullOrWhiteSpace(_game.Publisher) ? "" : $" · {_game.Publisher}")</p>
            </div>
            <div class="page-header-actions">
                <a class="btn btn-secondary" href="@($"/games/edit/{_game.Id}")">Bearbeiten</a>
                <button type="button" class="btn btn-outline-danger" @onclick="DeleteGameAsync">Löschen</button>
            </div>
        </div>

        <div class="glass-card ui-section">
            <div class="game-facts">
                @if (_game.MinPlayers is not null || _game.MaxPlayers is not null)
                {
                    <div><span>Spieler</span><strong>@_game.MinPlayers–@_game.MaxPlayers</strong></div>
                }
                @if (_game.ReleaseYear is not null) { <div><span>Jahr</span><strong>@_game.ReleaseYear</strong></div> }
                @foreach (var def in _game.ScoreDefinitions)
                {
                    <div><span>Score: @def.Name</span><strong>@(def.Unit)@(string.IsNullOrWhiteSpace(def.Unit) ? "" : " · ")@(def.HigherIsBetter ? "höher = besser" : "niedriger = besser")</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(_game.RulesFileName))
                {
                    <div><span>Anleitung</span><a href="@($"/games/{_game.Id}/rules")" target="_blank" rel="noopener">öffnen</a></div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_game.Description))
            {
                <p class="game-description">@_game.Description</p>
            }
        </div>

        @* ---- Expansions ---- *@
        <div class="glass-card ui-section ui-stack">
            <h2 class="ui-section-title">Erweiterungen</h2>
            @if (_game.Expansions.Count == 0)
            {
                <div class="text-muted">Noch keine Erweiterungen.</div>
            }
            else
            {
                <ul class="game-expansions">
                    @foreach (var ex in _game.Expansions)
                    {
                        <li @key="ex.Id">
                            <div class="game-expansion-main">
                                <strong>@ex.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(ex.Notes)) { <div class="text-muted small">@ex.Notes</div> }
                                @if (ex.Files.Count > 0)
                                {
                                    <div class="expansion-files">
                                        @foreach (var f in ex.Files)
                                        {
                                            <span class="expansion-file">
                                                <a href="@($"/games/expansions/file/{f.Id}")" target="_blank" rel="noopener">@(f.OriginalName ?? "Datei")</a>
                                                <button type="button" class="link-danger" @onclick="() => RemoveFileAsync(f.Id)">×</button>
                                            </span>
                                        }
                                    </div>
                                }
                                <label class="expansion-upload">
                                    <InputFile OnChange="(e) => OnExpansionFileSelected(e, ex.Id)" accept="application/pdf,image/*" />
                                </label>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteExpansionAsync(ex.Id)">Entfernen</button>
                        </li>
                    }
                </ul>
            }
            <div class="game-expansion-add">
                <input class="form-control" placeholder="Name der Erweiterung" @bind="_newExpansionName" />
                <input class="form-control" placeholder="Notiz (optional)" @bind="_newExpansionNotes" />
                <button type="button" class="btn btn-primary" @onclick="AddExpansionAsync">Hinzufügen</button>
            </div>
        </div>

        @* ---- Matches ---- *@
        <div class="glass-card ui-section ui-stack">
            <div class="toolbar">
                <h2 class="ui-section-title">Partien</h2>
                <a class="btn btn-primary" href="@($"/games/{_game.Id}/matches/new")">Neue Partie</a>
            </div>
            <div class="search-box" style="flex:1 1 20rem;">
                <input class="form-control" type="search" placeholder="Partie oder Person suchen"
                       @bind="_matchSearch" @bind:event="oninput" @bind:after="ReloadMatchesAsync" />
            </div>

            @if (_matches.Count == 0)
            {
                <div class="text-muted">Keine Partien gefunden.</div>
            }
            else
            {
                <table class="table ui-data-table align-middle">
                    <thead><tr><th>Datum</th><th>Titel</th><th>Personen (Score)</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var m in _matches)
                        {
                            <tr @key="m.Id">
                                <td>@m.PlayedOn.ToString("dd.MM.yyyy")</td>
                                <td>@(string.IsNullOrWhiteSpace(m.Title) ? "—" : m.Title)</td>
                                <td>@(m.Participants.Count == 0 ? "—" : string.Join(", ", m.Participants.Select(p => p.Score is null ? p.Person?.DisplayName : $"{p.Person?.DisplayName} ({p.Score:0.#})")))</td>
                                <td>@(m.IsCompleted ? "abgeschlossen" : "offen")</td>
                                <td><a class="btn btn-sm btn-outline-secondary" href="@($"/games/{_game.Id}/matches/{m.Id}")">Öffnen</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Game? _game;
    private List<GameMatch> _matches = new();
    private string _matchSearch = string.Empty;
    private string _newExpansionName = string.Empty;
    private string? _newExpansionNotes;
    private const long MaxFileBytes = 30 * 1024 * 1024;

    protected override async Task OnParametersSetAsync()
    {
        _game = await GameService.GetGameAsync(Id);
        if (_game is null) { Navigation.NavigateTo("/games"); return; }
        await ReloadMatchesAsync();
    }

    private async Task ReloadMatchesAsync()
    {
        _matches = (await GameService.GetMatchesForGameAsync(Id, string.IsNullOrWhiteSpace(_matchSearch) ? null : _matchSearch)).ToList();
    }

    private async Task AddExpansionAsync()
    {
        if (string.IsNullOrWhiteSpace(_newExpansionName)) return;
        await GameService.AddExpansionAsync(Id, _newExpansionName, _newExpansionNotes);
        _newExpansionName = string.Empty;
        _newExpansionNotes = null;
        _game = await GameService.GetGameAsync(Id);
    }

    private async Task DeleteExpansionAsync(int expansionId)
    {
        await GameService.DeleteExpansionAsync(expansionId);
        _game = await GameService.GetGameAsync(Id);
    }

    private async Task OnExpansionFileSelected(InputFileChangeEventArgs e, int expansionId)
    {
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(MaxFileBytes);
            await GameService.AddExpansionFileAsync(expansionId, stream, file.ContentType, file.Name);
            _game = await GameService.GetGameAsync(Id);
            ToastService.Success("Datei hinzugefügt.");
        }
        catch (Exception ex)
        {
            ToastService.Error(ex.Message);
        }
    }

    private async Task RemoveFileAsync(int fileId)
    {
        await GameService.RemoveExpansionFileAsync(fileId);
        _game = await GameService.GetGameAsync(Id);
    }

    private async Task DeleteGameAsync()
    {
        await GameService.DeleteGameAsync(Id);
        ToastService.Success("Spiel gelöscht.");
        Navigation.NavigateTo("/games");
    }
}
