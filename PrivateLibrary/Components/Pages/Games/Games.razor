@page "/games"
@using PrivateLibrary.Data
@using PrivateLibrary.Modules.Games
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject GameService GameService
@inject PrivateLibrary.Services.DeferredDeleteService DeferredDelete

<PageTitle>Spiele</PageTitle>

<div class="page-shell">
    <div class="glass-card page-header">
        <div>
            <h1>Spiele</h1>
            <p>Spielesammlung, Partien und Erweiterungen.</p>
        </div>
        <div class="header-actions">
            <a class="btn btn-primary" href="/games/new">Neues Spiel</a>
            <a class="btn btn-outline-secondary" href="/games/export.csv" target="_blank" rel="noopener">Spiele-CSV</a>
            <a class="btn btn-outline-secondary" href="/games/matches/export.csv" target="_blank" rel="noopener">Partien-CSV</a>
        </div>
    </div>

    @if (_recent.Count > 0)
    {
        <div class="glass-card ui-section ui-stack">
            <h2 class="ui-section-title">Zuletzt begonnene Partien</h2>
            <div class="game-recent-grid">
                @foreach (var m in _recent)
                {
                    <a class="game-recent-card" href="@($"/games/{m.GameId}/matches/{m.Id}")" @key="m.Id">
                        <div class="game-recent-title">@(m.Game?.Name ?? "Spiel")</div>
                        <div class="game-recent-sub">@(string.IsNullOrWhiteSpace(m.Title) ? m.PlayedOn.ToString("dd.MM.yyyy") : m.Title)</div>
                        <div class="game-recent-meta">
                            @if (m.IsCompleted) { <span class="badge text-bg-secondary">abgeschlossen</span> }
                            else { <span class="badge text-bg-success">offen</span> }
                            @if (m.Participants.Count > 0)
                            {
                                <span>@string.Join(", ", m.Participants.Select(p => p.Person?.DisplayName))</span>
                            }
                        </div>
                    </a>
                }
            </div>
        </div>
    }

    <div class="glass-card ui-section ui-stack">
        <div class="toolbar">
            <div class="search-box" style="flex:1 1 20rem;">
                <label class="search-label" for="game-search">Suche</label>
                <input id="game-search" class="form-control" type="search" placeholder="Spiel oder Verlag suchen"
                       @bind="_search" @bind:event="oninput" @bind:after="ReloadAsync" />
            </div>
            <div class="result-count">@_games.Count Spiele</div>
        </div>

        @if (_games.Count == 0)
        {
            <div class="text-muted">Keine Spiele gefunden.</div>
        }
        else
        {
            <div class="game-grid">
                @foreach (var g in _games)
                {
                    <SwipeToDelete @key="g.Id" DeleteLabel="Spiel löschen" OnDelete="() => DeleteGameAsync(g)">
                        <a class="game-card" href="@($"/games/{g.Id}")">
                            <div class="game-card-title">@g.Name</div>
                            <div class="game-card-meta">
                                @foreach (var t in g.Types)
                                {
                                    <span class="badge text-bg-info">@GameLabels.Type(t.Type)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(g.Publisher)) { <span>@g.Publisher</span> }
                            </div>
                        </a>
                    </SwipeToDelete>
                }
            </div>
        }
    </div>
</div>

@code {
    private IReadOnlyList<GameMatch> _recent = Array.Empty<GameMatch>();
    private List<Game> _games = new();
    private string _search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _recent = await GameService.GetRecentMatchesAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _games = (await GameService.GetGamesAsync(string.IsNullOrWhiteSpace(_search) ? null : _search)).ToList();
    }

    private Task DeleteGameAsync(Game game)
    {
        var index = _games.IndexOf(game);
        if (index < 0)
        {
            return Task.CompletedTask;
        }

        _games.RemoveAt(index);
        var restoreIndex = index;

        DeferredDelete.DeleteWithUndo(
            $"„{game.Name}“ gelöscht",
            commit: () => GameService.DeleteGameAsync(game.Id),
            restore: () =>
            {
                _games.Insert(Math.Min(restoreIndex, _games.Count), game);
                return InvokeAsync(StateHasChanged);
            });

        return InvokeAsync(StateHasChanged);
    }
}
