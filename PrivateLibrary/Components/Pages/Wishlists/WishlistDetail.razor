@page "/wishlists/{Id:int}"
@using PrivateLibrary.Data
@using PrivateLibrary.Modules.Wishlists
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject WishlistService WishlistService
@inject PrivateLibrary.Modules.Lending.Services.ToastService ToastService
@inject NotificationService Notifications
@inject NavigationManager Navigation

<PageTitle>@(_wishlist?.Name ?? "Wunschzettel")</PageTitle>

<div class="page-shell">
    @if (_wishlist is null)
    {
        <div class="glass-card">Lade ...</div>
    }
    else
    {
        <div class="glass-card page-header">
            <div>
                <h1>@_wishlist.Name</h1>
                <p>von @(_wishlist.OwnerUser?.DisplayName ?? "—")</p>
            </div>
            <div class="page-header-actions">
                @if (_canEdit)
                {
                    <button type="button" class="btn btn-outline-danger" @onclick="DeleteListAsync">Wunschzettel löschen</button>
                }
                <a class="btn btn-secondary" href="/wishlists">Zurück</a>
            </div>
        </div>

        @if (_canEdit)
        {
            <div class="glass-card ui-section">
                <h2 class="ui-section-title">Wunsch hinzufügen</h2>
                <div class="form-grid">
                    <div class="field field-wide"><label>Titel *</label><input class="form-control" @bind="_title" /></div>
                    <div class="field"><label>Link (optional)</label><input class="form-control" @bind="_url" /></div>
                    <div class="field"><label>Preis (optional)</label><input type="number" step="0.01" class="form-control" @bind="_price" /></div>
                    <div class="field field-wide"><label>Notiz (optional)</label><input class="form-control" @bind="_notes" /></div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary btn-modern" @onclick="AddItemAsync">Hinzufügen</button>
                </div>
            </div>
        }

        <div class="glass-card ui-section ui-stack">
            <h2 class="ui-section-title">Wünsche</h2>
            @if (_wishlist.Items.Count == 0)
            {
                <div class="text-muted">Noch keine Wünsche.</div>
            }
            else
            {
                <ul class="wish-items">
                    @foreach (var item in _wishlist.Items)
                    {
                        <li class="wish-item @(item.IsFulfilled ? "is-fulfilled" : "")" @key="item.Id">
                            <div class="wish-item-main">
                                <div class="wish-item-title">
                                    @if (!string.IsNullOrWhiteSpace(item.Url))
                                    {
                                        <a href="@item.Url" target="_blank" rel="noopener">@item.Title</a>
                                    }
                                    else { @item.Title }
                                    @if (item.Price is not null) { <span class="wish-item-price">@item.Price.Value.ToString("0.00") €</span> }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Notes)) { <div class="text-muted small">@item.Notes</div> }
                            </div>
                            @if (_canEdit)
                            {
                                <div class="wish-item-actions">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleFulfilledAsync(item)">
                                        @(item.IsFulfilled ? "Offen" : "Erfüllt")
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteItemAsync(item.Id)">Löschen</button>
                                </div>
                            }
                            else if (item.IsFulfilled)
                            {
                                <span class="badge text-bg-success">erfüllt</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Wishlist? _wishlist;
    private bool _canEdit;

    private string _title = string.Empty;
    private string? _url;
    private string? _notes;
    private decimal? _price;

    protected override async Task OnParametersSetAsync()
    {
        _wishlist = await WishlistService.GetWishlistAsync(Id);
        if (_wishlist is null) { Navigation.NavigateTo("/wishlists"); return; }
        _canEdit = await WishlistService.CanEditAsync(Id);
    }

    private async Task AddItemAsync()
    {
        if (string.IsNullOrWhiteSpace(_title)) { ToastService.Error("Bitte einen Titel eingeben."); return; }
        var addedTitle = _title;
        await WishlistService.AddItemAsync(Id, _title, _url, _notes, _price);
        _title = string.Empty; _url = null; _notes = null; _price = null;
        await Notifications.Notify(AppNotification.ItemAdded(
            "Neuer Wunsch", $"„{addedTitle}“ wurde dem Wunschzettel hinzugefügt.", $"/wishlists/{Id}"));
        _wishlist = await WishlistService.GetWishlistAsync(Id);
    }

    private async Task ToggleFulfilledAsync(WishlistItem item)
    {
        await WishlistService.SetItemFulfilledAsync(item.Id, !item.IsFulfilled);
        _wishlist = await WishlistService.GetWishlistAsync(Id);
    }

    private async Task DeleteItemAsync(int itemId)
    {
        await WishlistService.DeleteItemAsync(itemId);
        _wishlist = await WishlistService.GetWishlistAsync(Id);
    }

    private async Task DeleteListAsync()
    {
        await WishlistService.DeleteWishlistAsync(Id);
        ToastService.Success("Wunschzettel gelöscht.");
        Navigation.NavigateTo("/wishlists");
    }
}
