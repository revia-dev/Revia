@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(PrivateLibrary.Components.Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @{
                    // Use the relative path so the controller accepts it as a local URL.
                    var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
                    var returnUrl = Uri.EscapeDataString("/" + relativePath.TrimStart('/'));
                    Navigation.NavigateTo($"/account/login?returnUrl={returnUrl}", forceLoad: true);
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
