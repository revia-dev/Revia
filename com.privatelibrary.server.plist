<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.privatelibrary.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/revia-dev/Library/Scripts/privatelibrary-server.sh</string>
    </array>

    <key>UserName</key>
    <string>revia-dev</string>

    <key>WorkingDirectory</key>
    <string>/tmp</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/revia-dev</string>
        <key>PATH</key>
        <string>/usr/local/share/dotnet:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>DOTNET_ROOT</key>
        <string>/usr/local/share/dotnet</string>
    </dict>

    <!-- Startet beim Systemstart und nach Abstürzen automatisch neu -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Mindestens 10 Sekunden warten bevor Neustart bei Absturz -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/revia-dev/Library/Logs/PrivateLibrary/server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/revia-dev/Library/Logs/PrivateLibrary/server-error.log</string>
</dict>
</plist>
