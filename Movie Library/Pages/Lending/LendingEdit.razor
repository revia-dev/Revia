@page "/lending/new"
@page "/lending/edit/{Id:int}"
@using PrivateLibrary.Features.Lending.Models
@inject PrivateLibrary.Features.Lending.Services.ILendingService LendingService
@inject PrivateLibrary.Features.Lending.Services.IPersonService PersonService
@inject NavigationManager Navigation

<PageTitle>@PageTitleText</PageTitle>

<div class="page-shell">
    <div class="glass-card page-header">
        <div>
            <h1>@PageTitleText</h1>
            <p>Eintrag erfassen oder bearbeiten.</p>
        </div>
        <a class="btn btn-outline-secondary btn-modern" href="/lending/persons/new">Neue Person</a>
    </div>

    @if (_model is null)
    {
        <div class="glass-card loading-card">Lade Formular...</div>
    }
    else
    {
        <LendingEntryForm Model="_model" People="_people" SubmitText="@SubmitText" CancelUrl="/lending" OnValidSubmit="SaveAsync" />
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private LendingEntryEditModel? _model;
    private IReadOnlyList<Person> _people = Array.Empty<Person>();

    private string PageTitleText => Id.HasValue ? "Lending bearbeiten" : "Neuer Lending-Eintrag";
    private string SubmitText => Id.HasValue ? "Änderungen speichern" : "Eintrag anlegen";

    protected override async Task OnInitializedAsync()
    {
        _people = await PersonService.GetLookupAsync();

        if (Id.HasValue)
        {
            var item = await LendingService.GetByIdAsync(Id.Value);
            if (item is null)
            {
                Navigation.NavigateTo("/lending");
                return;
            }

            _model = new LendingEntryEditModel
            {
                Id = item.Id,
                Title = item.Title,
                Description = item.Description,
                ItemName = item.ItemName,
                Category = item.Category,
                LenderId = item.LenderId,
                BorrowerId = item.BorrowerId,
                LoanDate = item.LoanDate,
                DueDate = item.DueDate,
                ReturnedAt = item.ReturnedAt,
                Status = item.Status,
                Notes = item.Notes
            };
        }
        else
        {
            _model = new LendingEntryEditModel
            {
                LoanDate = DateTime.Today,
                Status = LendingEntryStatus.Active
            };
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        var entity = new LendingEntry
        {
            Id = _model.Id,
            Title = _model.Title,
            Description = _model.Description,
            ItemName = _model.ItemName,
            Category = _model.Category,
            LenderId = _model.LenderId ?? 0,
            BorrowerId = _model.BorrowerId ?? 0,
            LoanDate = _model.LoanDate ?? DateTime.Today,
            DueDate = _model.DueDate,
            ReturnedAt = _model.ReturnedAt,
            Notes = _model.Notes,
            Status = _model.Status
        };

        if (entity.Id == 0)
        {
            var created = await LendingService.CreateAsync(entity);
            Navigation.NavigateTo($"/lending/{created.Id}");
            return;
        }

        var updated = await LendingService.UpdateAsync(entity);
        if (updated is null)
        {
            Navigation.NavigateTo("/lending");
            return;
        }

        Navigation.NavigateTo($"/lending/{updated.Id}");
    }
}
