# Revia configuration — copy this file to ".env" and adjust the values, then run
#   docker compose up -d --build
# Everything below has a sensible default; for a private home setup you typically
# only change REVIA_JWT_KEY (and the admin password).

# Port the app is published on (host side).
REVIA_PORT=8080

# REQUIRED: a long random secret (32+ chars) used to sign auth tokens.
# Generate one, e.g.:  openssl rand -base64 48
REVIA_JWT_KEY=change-me-to-a-long-random-32+char-secret-please

# Initial admin password, used only when seeding a fresh database.
REVIA_ADMIN_PASSWORD=Admin123!

# Demo mode: "true" lets anyone log in via "Demo ansehen" without credentials.
# Use a THROWAWAY data volume for this (the demo resets on every restart).
REVIA_DEMO_ENABLED=false
REVIA_DEMO_RESET=true

# Optional: TMDb API key for movie posters/metadata (leave empty to skip).
REVIA_TMDB_KEY=
